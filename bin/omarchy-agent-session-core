#!/usr/bin/env python3
"""omarchy-agent-session-core

Slice-1 session store and command implementation for omarchy-multiplayer.
Proposed, 2026-09-01; not run against a real Omarchy/Herdr install. Every
`bin/omarchy-agent-session-<cmd>` shell wrapper execs into this file as
`omarchy-agent-session-core <cmd> "$@"`; this is the one place the session
record, event log, receipt, permission-mode table, and Herdr client live.

Standard library only (Python 3.11+ compatible; also runs on 3.10, which is
what this skeleton was tested against -- see README-core.md).

Spec files this implements: 01-session-model.md, 02-command-surface.md,
04-permission-modes.md, 05-receipts-and-artifacts.md, 07-worktrees.md.
Four commands (`preview`, `done`, `artifact-add`, `mode`) are only
cross-referenced by 02-command-surface.md into 04/09; 09-closed-loop-surfaces.md
itself was not part of this build's reading set, so those commands are
implemented from the cross-reference table alone. See README-core.md for the
exact list of assumptions this required.
"""

import argparse
import contextlib
import datetime as dt
import getpass
import json
import os
import pathlib
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request

# --------------------------------------------------------------------------
# Exit codes (spec-02's "Shared exit codes" table; every subcommand below
# uses this same vocabulary, per that file's framing).
# --------------------------------------------------------------------------

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_NOT_FOUND = 3
EXIT_HERDR_UNREACHABLE = 4
EXIT_CONFLICT = 5


class SessionError(Exception):
    exit_code = 1


class UsageError(SessionError):
    exit_code = EXIT_USAGE


class NotFoundError(SessionError):
    exit_code = EXIT_NOT_FOUND


class ConflictError(SessionError):
    """Name taken, depth/children limit, or an invariant refused the op."""

    exit_code = EXIT_CONFLICT


# --------------------------------------------------------------------------
# Session model constants (01-session-model.md)
# --------------------------------------------------------------------------

STATES = (
    "starting", "working", "waiting", "blocked", "idle",
    "done", "failed", "stopped", "orphaned",
)
TERMINAL_STATES = {"done", "failed", "stopped"}
NEEDS_ATTENTION_STATES = {"waiting", "blocked"}

EVENT_TYPES = (
    "session.created", "session.renamed", "owner.assigned", "mode.changed",
    "preview.set", "runtime.bound", "runtime.unbound", "status.changed",
    "goal.set", "instruction.queued", "instruction.delivered",
    "instruction.dropped", "child.spawned", "child.completed",
    "approval.requested", "approval.resolved", "artifact.added",
    "receipt.written", "session.ended",
    "lane.added", "lane.merged", "artifact.updated",
)

# 11-agent-lanes.md: a lane is one agent with one task inside a session,
# recorded as a child session with spawn_reason "lane". The session's own
# agent is addressed as the lane named LANE_MAIN. A lane's mode may be
# stricter than the session's and never looser.
LANE_MAIN = "main"
MODE_RANK = {"personal": 0, "shared": 1, "restricted": 2}

# 06-event-driven-state (pattern 06): a session may watch another. Every
# append to the watched session's log leaves at most one pending, marked
# instruction on each watcher, coalesced until it is delivered; instruction
# traffic itself never wakes a watcher, which keeps watching from echoing.
WATCH_SILENT_TYPES = {"instruction.queued", "instruction.delivered", "instruction.dropped", "receipt.written"}
# What a watcher is told about. Run 9 (2026-09-03): every runtime.bound and
# working/idle flip on a lane became a marked instruction to the session's
# own agent, and each one started a turn there. A watcher hears about the
# states that need a person or end the work, artifacts, merges, and endings.
WATCH_MATERIAL_STATES = {"blocked", "waiting", "failed", "done", "stopped", "orphaned"}
WATCH_MATERIAL_TYPES = {"artifact.added", "lane.merged", "child.completed", "session.ended", "goal.set"}
EVENTS_WARN_AT = 50000

# The state machine table from 01-session-model.md. ANY is the "any live
# state" wildcard used by three rows (-> done, -> failed, -> stopped).
ANY = "*any-live*"
VALID_TRANSITIONS = {
    ("starting", "working"),
    ("working", "waiting"),
    ("working", "blocked"),
    ("waiting", "working"),
    ("blocked", "working"),
    ("working", "idle"),
    ("idle", "working"),
    (ANY, "done"),
    (ANY, "failed"),
    (ANY, "stopped"),
    (ANY, "orphaned"),
    ("orphaned", "working"),
}


def is_valid_transition(from_state, to_state):
    if (from_state, to_state) in VALID_TRANSITIONS:
        return True
    if (ANY, to_state) in VALID_TRANSITIONS and from_state not in TERMINAL_STATES:
        return True
    return False


# Depth/children limits (01-session-model.md: "Both are configuration, both
# are enforced at session new"). Read as env-overridable, defaulting to the
# spec's own numbers, since the spec calls them "configuration" rather than
# fixed constants.
MAX_LINEAGE_DEPTH = int(os.environ.get("OMARCHY_SESSION_MAX_DEPTH", "3"))
MAX_CHILDREN = int(os.environ.get("OMARCHY_SESSION_MAX_CHILDREN", "5"))
MAX_PARTICIPANTS = 32


# --------------------------------------------------------------------------
# Paths (env overrides per the task contract)
# --------------------------------------------------------------------------

def sessions_root():
    env = os.environ.get("OMARCHY_SESSIONS_DIR")
    if env:
        return pathlib.Path(env)
    return pathlib.Path.home() / ".local" / "state" / "omarchy" / "sessions"


def herdr_socket_path():
    env = os.environ.get("HERDR_SOCKET")
    if env:
        return pathlib.Path(env)
    return pathlib.Path.home() / ".config" / "herdr" / "herdr.sock"


# Where new worktrees land (07-worktrees.md: Herdr's own worktrees.directory,
# default ~/.herdr/worktrees). This skeleton has no Herdr method to fetch the
# *configured* value (not in the required HerdrClient method list), so it
# always uses the documented default; querying the real value is
# VERIFY ON RIG per spec-07's own open question.
def herdr_worktrees_directory():
    env = os.environ.get("HERDR_WORKTREES_DIR")
    if env:
        return pathlib.Path(env)
    return pathlib.Path.home() / ".herdr" / "worktrees"


def eprint(*a, **kw):
    print(*a, file=sys.stderr, **kw)


# --------------------------------------------------------------------------
# Time
# --------------------------------------------------------------------------

def now_rfc3339():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_rfc3339(s):
    # Accept the "Z" suffix this module always writes, plus a bare offset
    # form, in case a hand-written fixture uses one.
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    return dt.datetime.fromisoformat(s)


# --------------------------------------------------------------------------
# ULID: Crockford base32 of a 48-bit millisecond timestamp + 80 bits of
# os.urandom. No dependency, per the task's "ULIDs from time and os.urandom"
# instruction.
# --------------------------------------------------------------------------

_CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"


def _encode_crockford(value, num_chars):
    chars = []
    for i in range(num_chars):
        shift = (num_chars - 1 - i) * 5
        chars.append(_CROCKFORD[(value >> shift) & 0x1F])
    return "".join(chars)


def new_ulid(now_ms=None, rand_bytes=None):
    if now_ms is None:
        now_ms = int(time.time() * 1000)
    if rand_bytes is None:
        rand_bytes = os.urandom(10)
    ts = now_ms & ((1 << 48) - 1)
    rand_int = int.from_bytes(rand_bytes, "big")
    return _encode_crockford(ts, 10) + _encode_crockford(rand_int, 16)


_ULID_RE = re.compile(r"^[0-9A-HJKMNP-TV-Z]{26}$")


def looks_like_ulid(s):
    return bool(_ULID_RE.match(s or ""))


# --------------------------------------------------------------------------
# Atomic writes (temp file + os.replace, per the session model and receipt
# lifecycle both requiring it)
# --------------------------------------------------------------------------

def atomic_write_text(path, text):
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(
        dir=str(path.parent), prefix="." + path.name + ".", suffix=".tmp"
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_name, str(path))
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise


def atomic_write_json(path, obj):
    atomic_write_text(path, json.dumps(obj, indent=2, sort_keys=False) + "\n")


# --------------------------------------------------------------------------
# Actors (01-session-model.md). The wire/string form used on the CLI and in
# the marker line and receipt rendering is "<kind>:<id>" (e.g.
# "human:praneet@rig"), per spec-02's `assign` example and spec-05's receipt
# rendering; the JSON object form used everywhere else is {kind, id, label},
# per spec-02's own `list --json` example ("id": "praneet@rig" with no
# prefix). Both are implemented; parse_actor_string / actor_to_string
# convert between them.
# --------------------------------------------------------------------------

ACTOR_KINDS = ("human", "agent", "system")


def current_human_actor():
    user = os.environ.get("USER") or os.environ.get("LOGNAME")
    if not user:
        with contextlib.suppress(Exception):
            user = getpass.getuser()
    user = user or "unknown"
    host = socket.gethostname().split(".")[0] or "localhost"
    return {"kind": "human", "id": f"{user}@{host}", "label": user}


def system_actor():
    return {"kind": "system", "id": "omarchy", "label": "omarchy"}


def agent_actor(session_id, label=None):
    return {"kind": "agent", "id": session_id, "label": label or session_id}


def actor_to_string(actor):
    return f"{actor['kind']}:{actor['id']}"


def parse_actor_string(s):
    if not s or ":" not in s:
        raise UsageError(f"invalid actor '{s}': expected <kind>:<id>, e.g. human:praneet@rig")
    kind, ident = s.split(":", 1)
    if kind not in ACTOR_KINDS:
        raise UsageError(f"invalid actor kind '{kind}': expected one of {', '.join(ACTOR_KINDS)}")
    if not ident:
        raise UsageError(f"invalid actor '{s}': missing id after '{kind}:'")
    label = ident.split("@", 1)[0] if kind == "human" else ident
    return {"kind": kind, "id": ident, "label": label}


# --------------------------------------------------------------------------
# Inter-agent marker line (02-command-surface.md, verbatim format)
# --------------------------------------------------------------------------

def format_marked_instruction(origin_id, origin_name, text):
    safe_name = (origin_name or "").replace("\n", " ").replace("]", "")
    return f"[omarchy-session-message from={origin_id} name={safe_name}]\n\n{text}"


# --------------------------------------------------------------------------
# Instructions (01-session-model.md)
# --------------------------------------------------------------------------

def new_instruction(text, author, delivery="steer", origin_session=None, about_artifact=None):
    instr = {
        "id": new_ulid(),
        "text": text,
        "author": author,
        "queued_at": now_rfc3339(),
        "delivery": delivery,
        "origin_session": origin_session,
    }
    # `about_artifact` is an extension beyond 01-session-model.md's own
    # Instruction shape: `send --about <artifact-id>` is only specified in
    # 09-closed-loop-surfaces.md (not part of this build's reading set), so
    # this field is this build's best guess at how the reference survives
    # onto the instruction; see README-core.md.
    if about_artifact:
        instr["about_artifact"] = about_artifact
    return instr


# --------------------------------------------------------------------------
# Permission modes (04-permission-modes.md): the harness flag table as data.
#
# Each cell:
#   kind: "flags" | "env" | "default" | "refuse" | "extra_file" | "extra_rule" | "none" | "inherits" | "unknown"
#   flags: list[str] appended to argv (possibly empty)
#   env: dict[str, str] of env vars to set (or None)
#   extra: free-form dict for a mechanism beyond argv/env (crush's disabled
#          tools list, agy's /permissions rule, grok's settings file)
#   note: human text carried from the spec's prose
#   verify_on_rig: True exactly on the cells the spec marks "(verify on
#          rig)"/"verify on rig", plus the ones the file's own bottom
#          "Verify on rig" list names explicitly (crush restricted, grok
#          restricted, agy restricted, hermes/pi shared+restricted -- see
#          README-core.md for the mapping from prose to this flag).
# --------------------------------------------------------------------------

def _cell(kind, flags=None, env=None, extra=None, note="", verify_on_rig=False):
    return {
        "kind": kind, "flags": flags or [], "env": env or {},
        "extra": extra or {}, "note": note, "verify_on_rig": verify_on_rig,
    }


HARNESS_TABLE = {
    "claude": {
        "personal": _cell("flags", ["--permission-mode", "auto"]),
        "shared": _cell("flags", ["--permission-mode", "default"]),
        "restricted": _cell("flags", ["--restricted", "--tools", "Read,Grep,Glob"]),
    },
    "codex": {
        "personal": _cell("flags", ["--approve-for-me"], verify_on_rig=True,
                           note="absent from the current CLI reference; documented "
                                "no-prompt paths are --ask-for-approval never and "
                                "--dangerously-bypass-approvals-and-sandbox (--yolo)."),
        "shared": _cell("flags", ["--sandbox", "workspace-write", "--ask-for-approval", "untrusted"]),
        "restricted": _cell("flags", ["--sandbox", "read-only", "--ask-for-approval", "never"]),
    },
    "opencode": {
        "personal": _cell("flags", ["--auto"]),
        "shared": _cell("env", env={"OPENCODE_PERMISSION": '{"permission":"ask"}'}),
        "restricted": _cell("env", env={
            "OPENCODE_PERMISSION": '{"permission":{"*":"deny","read":"allow","glob":"allow","grep":"allow"}}'
        }),
    },
    "copilot": {
        "personal": _cell("flags", ["--allow-all"]),
        "shared": _cell("default"),
        "restricted": _cell("flags", ["--available-tools=view,grep,glob"]),
    },
    "crush": {
        "personal": _cell("flags", ["--yolo"]),
        "shared": _cell("default"),
        "restricted": _cell(
            "extra_file",
            extra={"disabled_tools": ["bash", "edit", "multiedit", "write", "download", "job_output", "job_kill"]},
            note="a config file the launcher writes before exec, not a flag; "
                 "delivering it without touching the project's own .crush.json is verify on rig.",
            verify_on_rig=True,
        ),
    },
    "grok": {
        "personal": _cell("flags", ["--permission-mode", "bypassPermissions"]),
        "shared": _cell("flags", ["--permission-mode", "default"]),
        "restricted": _cell(
            "extra_rule",
            flags=["--allow", "Read", "--allow", "Grep", "--deny", "Bash", "--deny", "Edit"],
            extra={"settings_file": {"defaultMode": "dontAsk"}},
            note="dontAsk cannot be set by --permission-mode, only by defaultMode "
                 "in a settings file read at startup; the launcher writes that "
                 "file alongside the allow/deny flags.",
            verify_on_rig=True,
        ),
    },
    "hermes": {
        "personal": _cell("flags", ["--yolo"]),
        "shared": _cell("refuse", note="no mode that asks before every action.", verify_on_rig=True),
        "restricted": _cell("refuse", note="no read-only mode.", verify_on_rig=True),
    },
    "agy": {
        "personal": _cell("flags", ["--dangerously-skip-permissions"]),
        "shared": _cell("default"),
        "restricted": _cell(
            "extra_rule", flags=["--mode=plan"],
            extra={"permissions_rule": "read-only"},
            note="--mode=plan stops file writes but shell commands go through a "
                 "separate /permissions gate in every mode; restricted also needs "
                 "a read-only /permissions rule.",
            verify_on_rig=True,
        ),
    },
    "omp": {
        "personal": _cell("flags", ["--auto-approve"], verify_on_rig=True,
                           note="from a third party's integration notes, not OMP's own reference."),
        "shared": _cell("default", verify_on_rig=True),
        "restricted": _cell("unknown", note="tool filter unconfirmed.", verify_on_rig=True),
    },
    "pi": {
        "personal": _cell("none", note="ships no permission gate at all; nothing needed."),
        "shared": _cell("refuse", note="no config satisfies the mode's contract.", verify_on_rig=True),
        "restricted": _cell("refuse", note="no config satisfies the mode's contract.", verify_on_rig=True),
    },
    "ori": {
        # "inherits wrapped harness" for all three columns. This skeleton's
        # --agent <kind> is a single token with no documented syntax for
        # naming a wrapped harness (e.g. "ori claude"), so a bare "ori" is
        # always treated as its own native agent and, per spec-04, handled
        # like "pi" until the rig says otherwise. Wrapped-form resolution is
        # unimplemented; see README-core.md.
        "personal": _cell("none", note="bare ori has no confirmed flag in any mode; treated like pi."),
        "shared": _cell("refuse", note="treated like pi until the rig says otherwise.", verify_on_rig=True),
        "restricted": _cell("refuse", note="treated like pi until the rig says otherwise.", verify_on_rig=True),
    },
}

# 02-command-surface.md: Herdr agent aliases must match this.
_ALIAS_CHAR_RE = re.compile(r"[a-z0-9_-]")
_ALIAS_STARTS_LETTER_RE = re.compile(r"^[a-z]")


def validate_mode_supported(kind, mode):
    """Raise ConflictError if `kind` has no safe expression of `mode` at all
    (04-permission-modes.md's "no match, refuse" rows)."""
    row = HARNESS_TABLE.get(kind)
    if row is None:
        raise UsageError(f"unknown agent kind '{kind}'")
    cell = row[mode]
    if cell["kind"] == "refuse":
        raise ConflictError(
            f"harness '{kind}' has no safe expression of {mode} mode ({cell['note']}) "
            f"(invariant 5, 01-session-model.md)"
        )


def _contains_subsequence(argv, seq):
    if not seq:
        return False
    n, m = len(argv), len(seq)
    for i in range(0, n - m + 1):
        if argv[i:i + m] == seq:
            return True
    return False


def check_invariant5(kind, mode, argv, env):
    """A session in shared/restricted mode is never bound to a harness
    launched with a bypass-permissions flag (invariant 5). Checks the fully
    assembled argv/env -- the mode's own flags plus anything a caller tried
    to smuggle in via extra agent args -- against the harness's Personal-
    column deny-list, plus the one named "looks safe alone" combination
    (codex's --ask-for-approval never without --sandbox read-only)."""
    if mode == "personal":
        return
    row = HARNESS_TABLE.get(kind)
    if row is None:
        raise UsageError(f"unknown agent kind '{kind}'")
    deny_seq = row["personal"]["flags"]
    if _contains_subsequence(list(argv), list(deny_seq)):
        raise ConflictError(
            f"refusing {mode} launch for '{kind}': argv contains the Personal-mode "
            f"bypass flag {' '.join(deny_seq)!r} (invariant 5, 01-session-model.md)"
        )
    if kind == "codex" and "--ask-for-approval" in argv:
        # Scan every occurrence, not just the first: the mode's own cell
        # may already carry one --ask-for-approval before a smuggled extra
        # argument adds a second, later one.
        values = [argv[i + 1] for i, tok in enumerate(argv) if tok == "--ask-for-approval" and i + 1 < len(argv)]
        has_readonly_sandbox = _contains_subsequence(list(argv), ["--sandbox", "read-only"])
        if "never" in values and not has_readonly_sandbox:
            raise ConflictError(
                "refusing launch for 'codex': --ask-for-approval never without "
                "--sandbox read-only only looks safe alone (invariant 5, "
                "04-permission-modes.md)"
            )


def assemble_launch(kind, mode, extra_args=None):
    """Build the argv/env for launching `kind` in `mode`, plus the mode
    cell itself (so callers can act on extra_file/extra_rule mechanisms).
    Raises ConflictError via validate_mode_supported/check_invariant5."""
    validate_mode_supported(kind, mode)
    cell = HARNESS_TABLE[kind][mode]
    argv = list(cell["flags"]) + list(extra_args or [])
    env = dict(cell["env"])
    check_invariant5(kind, mode, argv, env)
    return argv, env, cell


def derive_herdr_alias(name, session_id, existing_aliases=()):
    """02-command-surface.md's alias derivation rule."""
    lowered = (name or "session").lower()
    out, prev_dash = [], False
    for ch in lowered:
        if _ALIAS_CHAR_RE.match(ch):
            out.append(ch)
            prev_dash = False
        elif not prev_dash:
            out.append("-")
            prev_dash = True
    slug = "".join(out).strip("-") or "s"
    if not _ALIAS_STARTS_LETTER_RE.match(slug):
        slug = "s-" + slug
    slug = slug[:32]
    if slug in existing_aliases:
        suffix = session_id[-4:].lower()
        slug = slug[: max(0, 31 - len(suffix))] + "-" + suffix
    return slug


# --------------------------------------------------------------------------
# Herdr client
# --------------------------------------------------------------------------

class HerdrUnavailable(Exception):
    """Herdr's socket is absent, refused the connection, or timed out."""


class HerdrError(Exception):
    """Herdr answered with a wire-level {"error": {...}} reply."""

    def __init__(self, code, message, data=None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.data = data


class HerdrClient:
    """Newline-delimited JSON over a Unix domain socket.

    Wire format as observed on Herdr 0.8.2 (rig, 2026-09-02; the schema
    is in spikes/): request {"id": "<string>", "method": "<name>",
    "params": {...}} on one line (Herdr rejects integer ids); reply
    {"id", "result": {"type": ..., ...}} on success or {"id", "error":
    {"code", "message", "data"}} on failure. `events_subscribe` uses the
    same framing as a long-lived stream of unsolicited lines after the
    subscribe reply.

    Every method here opens a fresh connection per call (simple and robust
    for a short-lived CLI process); `events_subscribe` is the one exception,
    since it needs to hold a connection open to read a stream.
    """

    def __init__(self, socket_path=None, timeout=5.0):
        self.socket_path = pathlib.Path(socket_path) if socket_path else herdr_socket_path()
        self.timeout = timeout
        self._next_id = 0

    def _id(self):
        # Herdr 0.8.2 rejects integer ids ("invalid type: integer, expected
        # a string"); verified on the rig 2026-09-02.
        self._next_id += 1
        return f"omarchy-agent-session-{os.getpid()}-{self._next_id}"

    def _connect(self, timeout=None):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(timeout or self.timeout)
        try:
            sock.connect(str(self.socket_path))
        except OSError as e:
            sock.close()
            raise HerdrUnavailable(f"cannot reach Herdr socket at {self.socket_path}: {e}") from e
        return sock

    def call(self, method, params=None, timeout=None):
        """Generic escape hatch for a Herdr method beyond the named ones
        below (e.g. worktree.open, worktree.remove, agent.send_keys,
        agent.focus, agent.read -- named by 02-command-surface.md /
        07-worktrees.md but not part of this client's required method
        list). `timeout` (seconds) overrides the socket timeout for calls
        that legitimately block, such as a prompt or wait with a long
        timeout_ms; without it a 5 s socket timeout cut a 180 s wait short
        (rig, 2026-09-02)."""
        sock = self._connect(timeout)
        try:
            req = {"id": self._id(), "method": method, "params": params or {}}
            try:
                sock.sendall((json.dumps(req) + "\n").encode("utf-8"))
                f = sock.makefile("r", encoding="utf-8")
                line = f.readline()
            except (OSError, socket.timeout) as e:
                raise HerdrUnavailable(f"Herdr call '{method}' failed: {e}") from e
            if not line:
                raise HerdrUnavailable(f"Herdr closed the connection with no reply to '{method}'")
            try:
                reply = json.loads(line)
            except json.JSONDecodeError as e:
                raise HerdrUnavailable(f"Herdr sent a non-JSON reply to '{method}': {e}") from e
            if reply.get("error"):
                err = reply["error"]
                raise HerdrError(err.get("code"), err.get("message", "Herdr error"), err.get("data"))
            return reply.get("result")
        finally:
            sock.close()

    # The methods below keep the parameter names the command layer uses and
    # translate them into Herdr 0.8.2's actual request shapes, all verified
    # on the rig 2026-09-02 against `herdr api schema --json` (protocol 20).

    def agent_list(self, **params):
        """Herdr agents carry `name` (the alias) and `agent` (the kind); the
        session record calls those agent_id and kind, so both spellings are
        present on every returned entry."""
        result = self.call("agent.list", params) or {}
        agents = []
        for a in result.get("agents", []):
            a = dict(a)
            a.setdefault("agent_id", a.get("name"))
            a.setdefault("kind", a.get("agent"))
            agents.append(a)
        return agents

    def pane_list(self, **params):
        result = self.call("pane.list", params) or {}
        return result.get("panes", [])

    def agent_get(self, agent_id=None, target=None, **_):
        result = self.call("agent.get", {"target": target or agent_id}) or {}
        return result.get("agent", result)

    def agent_start(self, alias, kind, cwd=None, flags=None, env=None, focus=False, pane_id=None, session_id=None, timeout_ms=90000):
        """Herdr needs a pane at a shell prompt first. Without a pane_id,
        create a workspace at cwd (its root pane is a fresh shell), then
        agent.start into that pane. Returns the runtime binding shape the
        session record stores."""
        workspace_id = tab_id = None
        if pane_id is None:
            created = self.call("workspace.create", {"cwd": cwd, "label": alias, "env": env or {}, "focus": bool(focus)}) or {}
            root = created.get("root_pane") or {}
            pane_id = root.get("pane_id")
            workspace_id = root.get("workspace_id") or (created.get("workspace") or {}).get("workspace_id")
            tab_id = root.get("tab_id")
            if not pane_id:
                raise HerdrError("no_pane", "workspace.create returned no root pane", created)
        # A pane Herdr just created needs a moment to reach its shell prompt;
        # agent.start answers "is not an available shell" until then
        # (rig, 2026-09-02). Retry for up to ten seconds on that one error.
        started = None
        for attempt in range(20):
            try:
                started = self.call("agent.start", {"name": alias, "kind": kind, "pane_id": pane_id,
                                                    "args": list(flags or []), "timeout_ms": timeout_ms}) or {}
                break
            except HerdrError as e:
                if "not an available shell" in str(e) and attempt < 19:
                    time.sleep(0.5)
                    continue
                raise
        agent = started.get("agent") or {}
        if session_id:
            with contextlib.suppress(HerdrError, HerdrUnavailable):
                self.call("pane.report_metadata", {"pane_id": pane_id, "source": "omarchy-agent-session",
                                                   "title": alias, "tokens": {"session_id": session_id}})
        return {"session": None, "workspace_id": workspace_id or agent.get("workspace_id"),
                "tab_id": tab_id or agent.get("tab_id"), "pane_id": agent.get("pane_id") or pane_id,
                "agent_id": agent.get("name") or alias}

    def agent_prompt(self, alias=None, text="", wait=False, until=None, timeout_ms=None, target=None, **_):
        params = {"target": target or alias, "text": text}
        if wait:
            # Herdr says `done` when a turn finishes and `idle` between
            # turns; this record folds both into `idle`, so a caller waiting
            # for our `idle` gets both (run 3, 2026-09-02: `--until idle`
            # timed out while Herdr sat on `done`).
            wanted = list(until or ["idle", "done", "blocked"])
            if "idle" in wanted and "done" not in wanted:
                wanted.append("done")
            params["wait"] = {"until": wanted, "timeout_ms": timeout_ms or 90000}
            return self.call("agent.prompt", params, timeout=(timeout_ms or 90000) / 1000 + 10)
        return self.call("agent.prompt", params)

    def agent_rename(self, agent_id=None, new_alias=None, target=None, name=None, **_):
        return self.call("agent.rename", {"target": target or agent_id, "name": name or new_alias})

    def pane_close(self, pane_id, **_):
        return self.call("pane.close", {"pane_id": pane_id})

    def pane_split(self, workspace_id=None, target_pane_id=None, cwd=None, direction="right", focus=False, **_):
        """A new shell pane beside an existing one in the same workspace;
        a lane's harness starts in it (11-agent-lanes.md). Returns the new
        pane's ids in the shape agent_start consumes."""
        params = {"direction": direction, "focus": bool(focus)}
        if workspace_id:
            params["workspace_id"] = workspace_id
        if target_pane_id:
            params["target_pane_id"] = target_pane_id
        if cwd:
            params["cwd"] = cwd
        created = self.call("pane.split", params) or {}
        pane = created.get("pane") or created
        return {"pane_id": pane.get("pane_id"), "workspace_id": pane.get("workspace_id") or workspace_id,
                "tab_id": pane.get("tab_id")}

    def worktree_create(self, repo=None, path=None, branch=None, base=None, focus=False, label=None, **_):
        return self.call("worktree.create", {"cwd": repo, "path": path, "branch": branch, "base": base,
                                             "focus": bool(focus), "label": label or branch})

    def events_subscribe(self, pane_ids=None, types=None):
        """Yields parsed events from a long-lived stream.

        Verified on the rig 2026-09-02 (Herdr 0.8.2, protocol 20): the
        request is {"id", "method": "events.subscribe", "params":
        {"subscriptions": [{"type": "<dotted.type>", ...}]}}. Types such as
        "pane.agent_status_changed" and "pane.scroll_changed" require a
        "pane_id" per subscription; workspace, tab, worktree, and the other
        pane types take none. The first reply is {"id", "result": {"type":
        "subscription_started"}}; every later line is {"event":
        "<underscore_name>", "data": {...}}, for example
        {"event": "workspace_renamed", "data": {"workspace_id": "w2", ...}}
        and, for status, {"event": "pane_agent_status_changed", "data":
        {"pane_id", "workspace_id", "agent_status", "agent", "title",
        "state_labels"}}."""
        subs = [{"type": t} for t in (types or ["pane.agent_detected", "pane.exited", "pane.closed", "pane.updated"])]
        for pane_id in pane_ids or []:
            subs.append({"type": "pane.agent_status_changed", "pane_id": pane_id})
        sock = self._connect()
        try:
            req = {"id": self._id(), "method": "events.subscribe", "params": {"subscriptions": subs}}
            sock.sendall((json.dumps(req) + "\n").encode("utf-8"))
            f = sock.makefile("r", encoding="utf-8")
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue
        finally:
            sock.close()


# --------------------------------------------------------------------------
# Git helpers (05-receipts-and-artifacts.md, 07-worktrees.md)
# --------------------------------------------------------------------------

class GitError(Exception):
    pass


def run_git(args, cwd=None, check=True):
    try:
        result = subprocess.run(
            ["git", *args], cwd=str(cwd) if cwd else None,
            capture_output=True, text=True,
        )
    except FileNotFoundError as e:
        raise GitError(f"git not found: {e}") from e
    if check and result.returncode != 0:
        raise GitError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result


def git_top_level(path):
    r = run_git(["rev-parse", "--show-toplevel"], cwd=path, check=False)
    if r.returncode != 0:
        return None
    return pathlib.Path(r.stdout.strip())


def git_current_branch(path):
    r = run_git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=path, check=False)
    if r.returncode != 0:
        return None
    branch = r.stdout.strip()
    return branch if branch and branch != "HEAD" else None


_UNSAFE_REF_RE = re.compile(r"[~^:?*\[\]\\\s]")


def git_safe_ref(name):
    """Best-effort git ref-name sanitizing. Unicode/emoji names are
    07-worktrees.md's own open "verify on rig" question; this is a plain
    ASCII-oriented pass, not a full `git check-ref-format` reimplementation."""
    s = _UNSAFE_REF_RE.sub("-", (name or "session").strip())
    s = re.sub(r"\.\.+", "-", s)
    s = s.strip("/.")
    s = re.sub(r"-{2,}", "-", s)
    return s or "session"


def create_worktree(repo_root, dest, branch, base_branch, herdr):
    dest = pathlib.Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    if herdr is not None:
        try:
            created = herdr.worktree_create(repo=str(repo_root), path=str(dest), branch=branch,
                                            base=base_branch, focus=False) or {}
            # Herdr opens the new worktree as a workspace whose root pane is
            # a fresh shell; the caller starts the harness in that pane so
            # no second workspace is created (verified on the rig 2026-09-02).
            return "herdr", created.get("root_pane") or {}
        except HerdrUnavailable:
            pass  # 07-worktrees.md: plain git when there is no Herdr backend
    run_git(["worktree", "add", str(dest), "-b", branch, base_branch], cwd=repo_root)
    return "git", {}


def remove_worktree(repo_root, worktree_path, herdr):
    # Herdr's worktree.remove takes the worktree's workspace_id, which the
    # session record does not keep, so removal goes through git directly.
    run_git(["worktree", "remove", str(worktree_path)], cwd=repo_root, check=False)
    return "git"


def git_commits(worktree_path, base_branch, branch):
    if not base_branch or not branch:
        return None
    r = run_git(["log", "--no-merges", "--reverse", "--format=%H\x1f%s\x1f%an",
                 f"{base_branch}..{branch}"], cwd=worktree_path, check=False)
    if r.returncode != 0:
        return None
    commits = []
    for line in r.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\x1f")
        if len(parts) == 3:
            commits.append({"sha": parts[0], "subject": parts[1], "author": parts[2]})
    return commits


def parse_shortstat(s):
    files = ins = dele = 0
    m = re.search(r"(\d+) files? changed", s)
    if m:
        files = int(m.group(1))
    m = re.search(r"(\d+) insertions?\(\+\)", s)
    if m:
        ins = int(m.group(1))
    m = re.search(r"(\d+) deletions?\(-\)", s)
    if m:
        dele = int(m.group(1))
    return {"files": files, "insertions": ins, "deletions": dele}


def git_diff_stat(worktree_path, base_branch, branch):
    if not base_branch or not branch:
        return None
    r = run_git(["diff", "--shortstat", f"{base_branch}...{branch}"], cwd=worktree_path, check=False)
    if r.returncode != 0:
        return None
    return parse_shortstat(r.stdout)


def git_dirty(worktree_path):
    r = run_git(["status", "--porcelain"], cwd=worktree_path, check=False)
    if r.returncode != 0:
        return None
    return bool(r.stdout.strip())


def git_has_remote(worktree_path):
    r = run_git(["remote"], cwd=worktree_path, check=False)
    return bool(r.stdout.strip()) if r.returncode == 0 else False


def git_unpushed(worktree_path, branch):
    if not branch:
        return None
    if not git_has_remote(worktree_path):
        return True
    r = run_git(["rev-list", branch, "--not", "--remotes"], cwd=worktree_path, check=False)
    if r.returncode != 0:
        return None
    return bool(r.stdout.strip())


def git_merged_into(worktree_path, branch, base_branch):
    r = run_git(["merge-base", "--is-ancestor", branch, base_branch], cwd=worktree_path, check=False)
    return r.returncode == 0


def decide_worktree_cleanup(worktree_path, branch, base_branch):
    """07-worktrees.md's cleanup table. Only meaningful when the worktree
    still exists; callers check created_by_session first. Returns
    (should_remove, reason)."""
    if git_dirty(worktree_path):
        return False, "uncommitted changes present"
    merged = bool(branch and base_branch and git_merged_into(worktree_path, branch, base_branch))
    pushed = bool(branch) and git_has_remote(worktree_path) and not git_unpushed(worktree_path, branch)
    if merged or pushed:
        return True, "merged into base_branch" if merged else "pushed to a remote"
    return False, "committed but not pushed to any remote and not merged into base_branch"


def cleanup_workspace_if_owned(session, herdr):
    """Runs 07-worktrees.md's cleanup table at a session's terminal
    transition (called from `stop` and `done`). No-op unless this session's
    own `new` created the worktree (created_by_session) and it still
    exists; a shared or plain (--no-worktree / no-repo) workspace is never
    touched. The branch itself is never deleted (invariant 7) -- only the
    worktree directory, via remove_worktree(), which already keeps the
    branch. Mutates session["workspace"] in place with `worktree_removed`
    and `worktree_removed_reason`, which then flow into the receipt
    unchanged since compute_receipt copies `workspace` wholesale."""
    ws = session.get("workspace") or {}
    worktree_path = ws.get("worktree_path")
    if not ws.get("created_by_session") or not worktree_path or not pathlib.Path(worktree_path).exists():
        return
    should_remove, reason = decide_worktree_cleanup(worktree_path, ws.get("branch"), ws.get("base_branch"))
    if should_remove:
        remove_worktree(ws.get("repo_root"), worktree_path, herdr)
    ws["worktree_removed"] = should_remove
    ws["worktree_removed_reason"] = reason
    session["workspace"] = ws


# --------------------------------------------------------------------------
# Session store
# --------------------------------------------------------------------------

class SessionStore:
    def __init__(self, root):
        self.root = pathlib.Path(root)

    def session_dir(self, session_id):
        return self.root / session_id

    def session_json_path(self, session_id):
        return self.session_dir(session_id) / "session.json"

    def events_path(self, session_id):
        return self.session_dir(session_id) / "events.jsonl"

    def receipt_path(self, session_id):
        return self.session_dir(session_id) / "receipt.json"

    def artifacts_dir(self, session_id):
        return self.session_dir(session_id) / "artifacts"

    def index_path(self):
        """The reconciler's liveness index, read by the panel's FileView
        (03-sessions-panel.md); a file, so all_ids() never mistakes it for
        a session directory."""
        return self.root / "index.json"

    def session_exists(self, session_id):
        return self.session_json_path(session_id).exists()

    def all_ids(self):
        if not self.root.exists():
            return []
        return sorted(
            p.name for p in self.root.iterdir()
            if p.is_dir() and (p / "session.json").exists()
        )

    def try_load(self, session_id):
        path = self.session_json_path(session_id)
        if not path.exists():
            return None
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return None

    def load(self, id_or_name):
        s = self.try_load(id_or_name)
        if s is not None:
            return s
        matches = [m for m in self.list_sessions() if m.get("name") == id_or_name]
        if not matches:
            raise NotFoundError(f"no session matches id or name '{id_or_name}'")
        live = [m for m in matches if m["status"]["state"] not in TERMINAL_STATES]
        pool = live or matches
        pool.sort(key=lambda m: m["created_at"], reverse=True)
        return pool[0]

    def list_sessions(self):
        out = []
        for sid in self.all_ids():
            s = self.try_load(sid)
            if s is not None:
                out.append(s)
        return out

    def save_session(self, session):
        atomic_write_json(self.session_json_path(session["id"]), session)

    def _last_seq(self, session_id):
        path = self.events_path(session_id)
        if not path.exists():
            return 0
        last = 0
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                with contextlib.suppress(json.JSONDecodeError):
                    last = max(last, json.loads(line).get("seq", 0))
        return last

    def append_event(self, session_id, event_type, actor, data=None):
        if event_type not in EVENT_TYPES:
            raise ValueError(f"unknown event type '{event_type}'")
        seq = self._last_seq(session_id) + 1
        event = {"seq": seq, "ts": now_rfc3339(), "type": event_type, "actor": actor, "data": data or {}}
        path = self.events_path(session_id)
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(event, sort_keys=False) + "\n")
            f.flush()
            os.fsync(f.fileno())
        if seq == EVENTS_WARN_AT:
            # 06-event-driven-state: no rotation in slice 2. A session log is
            # days long at most; one this size is a runaway, and the record
            # says so once instead of quietly growing.
            eprint(f"session {session_id}: events.jsonl reached {seq} rows; this session should end")
        if watch_material(event):
            notify_watchers(self, session_id, event)
        return event

    def read_events(self, session_id, since=None, type_filter=None):
        path = self.events_path(session_id)
        if not path.exists():
            return []
        out = []
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if since is not None and e.get("seq", 0) <= since:
                    continue
                if type_filter is not None and e.get("type") != type_filter:
                    continue
                out.append(e)
        return out

    def name_taken(self, name, exclude_id=None):
        """Name uniqueness is scoped to "live" sessions (01-session-model.md
        doesn't define "live" precisely outside the state machine's own
        state list; this build reads it as "not yet in a terminal state",
        i.e. every state except done/failed/stopped, orphaned included since
        an orphaned session can still be reopened)."""
        for s in self.list_sessions():
            if s["id"] == exclude_id:
                continue
            if s["status"]["state"] in TERMINAL_STATES:
                continue
            if s["name"] == name:
                return True
        return False


def compute_depth(store, session_id):
    depth, cur, seen = 0, session_id, set()
    while True:
        if cur in seen:
            break  # defensive: never loop on a corrupt lineage cycle
        seen.add(cur)
        s = store.try_load(cur)
        if not s:
            break
        parent = s.get("lineage", {}).get("parent_id")
        if not parent:
            break
        depth += 1
        cur = parent
    return depth


# --------------------------------------------------------------------------
# Artifacts (05-receipts-and-artifacts.md)
# --------------------------------------------------------------------------

_LABEL_SAFE_RE = re.compile(r"[^A-Za-z0-9._-]+")


def sanitize_label_for_filename(label):
    s = _LABEL_SAFE_RE.sub("-", (label or "").strip())
    return s.strip("-") or "artifact"


def fetch_url_title(url):
    """Best-effort <title> fetch; a failed fetch leaves the label as the
    bare URL, per 05-receipts-and-artifacts.md."""
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "omarchy-agent-session-core/1"})
        with urllib.request.urlopen(req, timeout=3) as resp:  # noqa: S310 (fixed scheme set below)
            html = resp.read(65536).decode("utf-8", errors="replace")
        m = re.search(r"<title[^>]*>(.*?)</title>", html, re.IGNORECASE | re.DOTALL)
        if m:
            return re.sub(r"\s+", " ", m.group(1)).strip()
    except Exception:
        return None
    return None


def add_artifact(store, session_id, kind, source, label, added_by, state="proposed"):
    """Writes the artifact file plus its JSON sidecar under artifacts/,
    named <ulid>-<label>.<ext>, per 05-receipts-and-artifacts.md. Returns
    (index_entry, artifact_path)."""
    artifacts_dir = store.artifacts_dir(session_id)
    artifacts_dir.mkdir(parents=True, exist_ok=True)
    ulid = new_ulid()
    resolved_source = source

    if kind == "file":
        src_path = pathlib.Path(source).expanduser()
        if not src_path.is_file():
            raise UsageError(f"--file path does not exist: {source}")
        ext = src_path.suffix.lstrip(".") or "bin"
        resolved_label = label or src_path.stem
        dest = artifacts_dir / f"{ulid}-{sanitize_label_for_filename(resolved_label)}.{ext}"
        shutil.copyfile(src_path, dest)
        resolved_source = str(src_path)
    elif kind == "url":
        resolved_label = label or fetch_url_title(source) or source
        dest = artifacts_dir / f"{ulid}-{sanitize_label_for_filename(resolved_label)}.url"
        atomic_write_text(dest, source + "\n")
    elif kind == "note":
        resolved_label = label or "note"
        dest = artifacts_dir / f"{ulid}-{sanitize_label_for_filename(resolved_label)}.txt"
        atomic_write_text(dest, source)
        resolved_source = "typed"
    elif kind == "capture":
        # `source` is already a real file on disk (produced by the capture
        # command's screenshot/region logic); move it into place here.
        src_path = pathlib.Path(source)
        ext = src_path.suffix.lstrip(".") or "png"
        resolved_label = label or src_path.stem
        dest = artifacts_dir / f"{ulid}-{sanitize_label_for_filename(resolved_label)}.{ext}"
        shutil.move(str(src_path), str(dest))
    else:
        raise UsageError(f"unknown artifact kind '{kind}'")

    added_at = now_rfc3339()
    sidecar = dest.with_suffix(dest.suffix + ".json") if False else artifacts_dir / (dest.stem + ".json")
    sidecar_data = {
        "label": resolved_label, "added_by": added_by, "added_at": added_at,
        "kind": kind, "source": resolved_source, "state": state,
    }
    atomic_write_json(sidecar, sidecar_data)
    entry = {"path": str(dest), "label": resolved_label, "added_by": added_by, "added_at": added_at}
    return entry, dest


def read_artifacts_index(artifacts_dir):
    artifacts_dir = pathlib.Path(artifacts_dir)
    if not artifacts_dir.exists():
        return []
    entries = []
    for sidecar in sorted(artifacts_dir.glob("*.json")):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        stem = sidecar.stem
        candidates = [p for p in artifacts_dir.glob(stem + ".*") if p.suffix != ".json"]
        entries.append({
            "path": str(candidates[0]) if candidates else None,
            "label": data.get("label"), "added_by": data.get("added_by"),
            "added_at": data.get("added_at"),
            "kind": data.get("kind"), "source": data.get("source"), "state": data.get("state"),
        })
    return entries


def mark_artifact(store, session_id, label_or_path, state):
    """Relabel an artifact `proposed` or `live` in its sidecar
    (05-receipts-and-artifacts.md); the loop view and the receipt read the
    sidecar. Returns the sidecar data."""
    artifacts_dir = store.artifacts_dir(session_id)
    for sidecar in sorted(artifacts_dir.glob("*.json")):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        stem = sidecar.stem
        paths = [str(p) for p in artifacts_dir.glob(stem + ".*") if p.suffix != ".json"]
        if data.get("label") == label_or_path or label_or_path in paths or stem.startswith(str(label_or_path)):
            data["state"] = state
            data["state_changed_at"] = now_rfc3339()
            atomic_write_json(sidecar, data)
            data["path"] = paths[0] if paths else None
            return data
    raise NotFoundError(f"no artifact '{label_or_path}' on session {session_id}")


class CaptureError(SessionError):
    exit_code = EXIT_USAGE  # `capture`'s own Exit table is 0,2,3 -- no 4/5


def do_screenshot_capture(session):
    """--screenshot's underlying mechanism: 05-receipts-and-artifacts.md
    describes `capture window`/`capture region` against `omarchy capture
    screenshot`; mapping --screenshot to one of the two is left to core's
    judgment by the shell layer (README-shell.md). This maps it to `windows`
    (matching a session's own registered preview window when set, else
    whatever has focus, exactly as spec-05 describes), falling back to
    `fullscreen` -- which the manual confirms is unattended -- if `windows`
    can't complete without a person clicking. Both are unconfirmed against a
    real compositor: VERIFY ON RIG."""
    scratch = pathlib.Path(tempfile.mkdtemp(prefix="omarchy-capture-"))
    env = dict(os.environ)
    env["OMARCHY_SCREENSHOT_DIR"] = str(scratch)
    try:
        subprocess.run(["omarchy", "capture", "screenshot", "windows", "save"],
                        env=env, check=True, capture_output=True, text=True, timeout=15)
        source_hint = "window"
    except (FileNotFoundError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        try:
            subprocess.run(["omarchy", "capture", "screenshot", "fullscreen", "save"],
                            env=env, check=True, capture_output=True, text=True, timeout=15)
            source_hint = "monitor"
        except (FileNotFoundError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as e2:
            raise CaptureError(f"screenshot tool unavailable in this environment (verify on rig): {e2}") from e2
    files = sorted(scratch.glob("*"))
    if not files:
        raise CaptureError("screenshot tool produced no file (verify on rig)")
    return files[-1], source_hint


# --------------------------------------------------------------------------
# Receipts (05-receipts-and-artifacts.md, 07-worktrees.md)
# --------------------------------------------------------------------------

def compute_receipt(store, session, end_state=None, end_reason=None, ended_at=None):
    ws = session.get("workspace") or {}
    worktree_path, base_branch, branch = ws.get("worktree_path"), ws.get("base_branch"), ws.get("branch")
    repo_root = ws.get("repo_root")
    worktree_exists = bool(worktree_path) and pathlib.Path(worktree_path).exists()
    # A clean, owned worktree may already have been removed by
    # cleanup_workspace_if_owned (07-worktrees.md) by the time a receipt is
    # written. `log`/`diff --shortstat`/`rev-list` only read refs and don't
    # need a working tree, so they still run fine from repo_root; only
    # `status --porcelain` (dirty) genuinely needs the worktree, and a
    # worktree cleanup only ever removes a worktree it already found clean.
    git_cwd = worktree_path if worktree_exists else repo_root
    has_git = bool(git_cwd) and pathlib.Path(git_cwd).exists() and bool(base_branch) and bool(branch)

    if has_git:
        commits = git_commits(git_cwd, base_branch, branch)
        diff_stat = git_diff_stat(git_cwd, base_branch, branch)
        dirty = git_dirty(worktree_path) if worktree_exists else False
        unpushed = git_unpushed(git_cwd, branch)
    else:
        commits = diff_stat = dirty = unpushed = None

    started_at = session["created_at"]
    end_dt = parse_rfc3339(ended_at) if ended_at else dt.datetime.now(dt.timezone.utc)
    duration_s = int((end_dt - parse_rfc3339(started_at)).total_seconds())

    events = store.read_events(session["id"])
    delivered = [e for e in events if e["type"] == "instruction.delivered"]
    dropped = [e for e in events if e["type"] == "instruction.dropped"]
    authors = sorted({actor_to_string(e["actor"]) for e in delivered if e.get("actor")})
    approvals_req = [e for e in events if e["type"] == "approval.requested"]
    approvals_res = [e for e in events if e["type"] == "approval.resolved"]
    approved = sum(1 for e in approvals_res if e.get("data", {}).get("decision") == "approved")
    denied = sum(1 for e in approvals_res if e.get("data", {}).get("decision") == "denied")
    children = [
        {"id": e["data"]["child_id"], "end_state": e["data"]["state"]}
        for e in events if e["type"] == "child.completed"
    ]
    # 11-agent-lanes.md: a session's receipt lists its lanes with the
    # commits each one merged; a lane's receipt names its session.
    lanes = []
    merged_by_child = {e["data"].get("child_id"): e["data"] for e in events if e["type"] == "lane.merged"}
    for e in events:
        if e["type"] != "lane.added":
            continue
        d = e["data"]
        child = store.try_load(d.get("child_id"))
        cst = (child or {}).get("status") or {}
        merged = merged_by_child.get(d.get("child_id"))
        lanes.append({"lane": d.get("lane"), "id": d.get("child_id"), "kind": (d.get("agent") or {}).get("kind"),
                      "task": d.get("task"), "end_state": cst.get("state"), "detail": cst.get("detail"),
                      "merged_commits": (merged or {}).get("commits") or [], "range": (merged or {}).get("range")})

    return {
        "session_id": session["id"], "name": session["name"], "agent": session["agent"],
        "owner": session["owner"]["actor"], "created_by": session["created_by"],
        "started_at": started_at, "ended_at": ended_at, "duration_s": duration_s,
        "end_state": end_state, "end_reason": end_reason,
        "started_with": session["started_with"], "goal": session.get("goal"),
        "workspace": session.get("workspace"),
        "commits": commits, "diff_stat": diff_stat, "dirty": dirty, "unpushed": unpushed,
        "artifacts": read_artifacts_index(store.artifacts_dir(session["id"])),
        "instructions": {"delivered": len(delivered), "dropped": len(dropped), "authors": authors},
        "approvals": {"requested": len(approvals_req), "approved": approved, "denied": denied},
        "children": children,
        "lanes": lanes,
        "lane": session.get("lane"),
        "harness_session_ref": session["agent"].get("harness_session_ref"),
        "state_version": session["state_version"],
    }


def write_receipt(store, receipt):
    atomic_write_json(store.receipt_path(receipt["session_id"]), receipt)


def render_receipt_text(receipt):
    """Fixed-order plain-text rendering, same groups every time whether or
    not a group has anything in it, per 05-receipts-and-artifacts.md."""
    lines = []
    ws = receipt.get("workspace") or {}
    goal = receipt.get("goal")
    lines.append(f"Session    {receipt['name']}  {receipt['session_id']}")
    agent = receipt["agent"]
    lines.append(f"Agent      {agent.get('kind')}   harness ref {agent.get('harness_session_ref')}")
    lines.append(f"Owner      {actor_to_string(receipt['owner'])}   created by {actor_to_string(receipt['created_by'])}")
    status_bits = f"{receipt.get('end_state') or 'in progress'}"
    lines.append(f"Status     {status_bits}   {receipt['started_at']} -> {receipt.get('ended_at')}, {receipt['duration_s']}s")
    started_with = receipt.get("started_with") or {}
    lines.append(f"Started    {started_with.get('command')}   cwd {started_with.get('cwd')}")
    lines.append(f"Goal       {goal['text'] if goal else '(none)'}")
    lines.append("")
    lines.append(
        f"Workspace  repo {ws.get('repo_root')}   worktree {ws.get('worktree_path')}   "
        f"branch {ws.get('branch')}   base {ws.get('base_branch')}"
    )
    commits = receipt.get("commits")
    lines.append(f"Commits    {len(commits) if commits is not None else 'n/a'}")
    for c in (commits or []):
        lines.append(f"  {c['sha'][:7]}  {c['subject']}")
    diff_stat = receipt.get("diff_stat")
    if diff_stat is not None:
        lines.append(f"Diff       {diff_stat['files']} files changed, {diff_stat['insertions']} insertions(+), {diff_stat['deletions']} deletions(-)")
    else:
        lines.append("Diff       n/a")
    lines.append(f"Dirty      {receipt.get('dirty')}")
    lines.append(f"Unpushed   {receipt.get('unpushed')}")
    lines.append("")
    artifacts = receipt.get("artifacts") or []
    lines.append(f"Artifacts  {len(artifacts)}")
    for a in artifacts:
        name = a.get("source") if a.get("kind") == "url" else (pathlib.Path(a["path"]).name if a.get("path") else "(missing)")
        state = f"   {a['state']}" if a.get("state") else ""
        lines.append(f"  {name}   {a['label']}{state}   {a['added_at']}   {actor_to_string(a['added_by']) if isinstance(a['added_by'], dict) else a['added_by']}")
    lines.append("")
    instr = receipt["instructions"]
    lines.append(f"Instructions  {instr['delivered']} delivered, {instr['dropped']} dropped, {len(instr['authors'])} author(s) ({', '.join(instr['authors'])})")
    appr = receipt["approvals"]
    lines.append(f"Approvals     {appr['requested']} requested, {appr['approved']} approved, {appr['denied']} denied")
    children = receipt.get("children") or []
    lines.append(f"Children      {'none' if not children else ', '.join(c['id'] + ':' + c['end_state'] for c in children)}")
    lane = receipt.get("lane")
    if lane:
        lines.append(f"Lane          {lane.get('name')} of session {lane.get('parent_name') or lane.get('parent_id')}")
    lanes = receipt.get("lanes") or []
    if lanes:
        lines.append("")
        lines.append("Lanes")
        for l in lanes:
            merged = f"{len(l['merged_commits'])} commit(s) merged ({l['range']})" if l.get("merged_commits") else "nothing merged"
            lines.append(f"  {l['lane']:<12} {l.get('kind') or '?':<9} {l.get('end_state') or '?':<9} {merged}   {l.get('task') or ''}")
    lines.append("")
    lines.append(f"Receipt    state_version {receipt['state_version']}")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# Session construction (new)
# --------------------------------------------------------------------------

def summarize_env():
    # env_summary's shape is undefined by 01-session-model.md; kept small
    # and non-secret on purpose.
    return {"shell": os.environ.get("SHELL"), "term": os.environ.get("TERM")}


def resolve_workspace(cwd, name, worktree_ref, no_worktree, herdr, base=None):
    cwd = pathlib.Path(cwd).resolve()
    repo_root = git_top_level(cwd)

    if worktree_ref:
        path = pathlib.Path(worktree_ref).expanduser().resolve()
        branch = git_current_branch(path) if path.exists() else None
        return {
            "repo_root": str(repo_root) if repo_root else None,
            "worktree_path": str(path), "branch": branch, "base_branch": None,
            "created_by_session": False,
        }

    if repo_root is None or no_worktree:
        return {
            "repo_root": str(repo_root) if repo_root else None,
            "worktree_path": str(cwd), "branch": None, "base_branch": None,
            "created_by_session": False,
        }

    base_branch = base or git_current_branch(repo_root)
    branch_name = f"session/{git_safe_ref(name)}"
    dest = herdr_worktrees_directory() / git_safe_ref(name)
    _backend, root_pane = create_worktree(repo_root, dest, branch_name, base_branch, herdr)
    return {
        "repo_root": str(repo_root), "worktree_path": str(dest),
        "branch": branch_name, "base_branch": base_branch, "created_by_session": True,
        "_herdr_root_pane": root_pane,
    }


def check_invariant6(store, workspace, new_session_created_by_session):
    """Two sessions never share a worktree unless both records name the
    same worktree_path and both say created_by_session: false
    (07-worktrees.md, invariant 6)."""
    if new_session_created_by_session:
        return  # this session made its own worktree; nothing to share yet
    path = workspace.get("worktree_path")
    if not path:
        return
    for s in store.list_sessions():
        other_ws = s.get("workspace") or {}
        if other_ws.get("worktree_path") == path and other_ws.get("created_by_session") is True:
            raise ConflictError(
                f"refusing to share worktree '{path}': session {s['id']} auto-created it "
                f"(created_by_session: true) (invariant 6, 01-session-model.md)"
            )


_NAME_SLUG_RUN_RE = re.compile(r"[^a-z0-9]+")
NAME_SLUG_LIMIT = 28


def slugify_name(text, limit=NAME_SLUG_LIMIT):
    """Lowercase; every run outside [a-z0-9] becomes one '-'; strip
    leading/trailing '-'; cut to `limit` characters and strip a trailing
    '-' again. Returns '' when nothing survives."""
    slug = _NAME_SLUG_RUN_RE.sub("-", (text or "").lower()).strip("-")
    return slug[:limit].rstrip("-")


def default_session_name(kind, cwd=None, prompt=None, existing_names=()):
    """The name `new` uses when --name is absent: the first four words of
    --prompt, else the basename of cwd, else the harness kind, each
    slugified (an empty slug falls through to the next source). Prefixed
    with `s-` when the result would not start with a letter, so the name
    the panel shows is the alias Herdr shows (02-command-surface.md's
    alias rule; derive_herdr_alias would add the same prefix anyway).
    Then made unique against `existing_names` -- every session name on
    disk, live or ended, so a receipt's name stays unambiguous -- by
    appending -2, -3, ... until free."""
    base = None
    words = (prompt or "").split()
    if words:
        base = slugify_name(" ".join(words[:4])) or None
    if base is None and cwd:
        base = slugify_name(os.path.basename(os.path.normpath(cwd))) or None
    if base is None:
        base = slugify_name(kind) or "session"
    if not _ALIAS_STARTS_LETTER_RE.match(base):
        base = "s-" + base
    taken = set(existing_names or ())
    name, n = base, 1
    while name in taken:
        n += 1
        name = f"{base}-{n}"
    return name


def new_session_record(session_id, name, created_by, owner, mode, agent_kind, workspace,
                        cwd, command, goal_text=None, parent_id=None, spawn_reason=None, lane=None):
    now = now_rfc3339()
    return {
        "lane": lane,
        "id": session_id, "name": name, "created_at": now, "created_by": created_by,
        "owner": {"actor": owner, "assigned_at": now, "assigned_by": created_by},
        "participants": [{"actor": created_by, "first_input_at": now, "last_input_at": now}],
        "agent": {"kind": agent_kind, "harness_session_ref": None, "version": None},
        "mode": mode, "workspace": workspace, "runtime": None,
        "status": {"state": "starting", "since": now, "source": "omarchy", "detail": None},
        "lineage": {"parent_id": parent_id, "children": [], "spawn_reason": spawn_reason},
        "goal": {"text": goal_text, "set_by": created_by, "set_at": now} if goal_text else None,
        "queue": [], "state_version": 0, "labels": [], "preview": None,
        "started_with": {"command": command, "cwd": cwd, "env_summary": summarize_env()},
    }


