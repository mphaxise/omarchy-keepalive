GOAL_LINE_LIMIT = 120


def goal_first_line(goal, limit=GOAL_LINE_LIMIT):
    """The panel's "What" column (03-sessions-panel.md): the first
    non-empty line of the goal text, stripped and cut to `limit`
    characters; None when there is no goal."""
    text = (goal or {}).get("text") if isinstance(goal, dict) else None
    if not isinstance(text, str):
        return None
    for line in text.splitlines():
        line = line.strip()
        if line:
            return line[:limit]
    return None


def session_project(s):
    """Basename of workspace.repo_root, else of started_with.cwd, else
    None -- the repo a session works in, for the panel row."""
    ws = s.get("workspace") or {}
    started = s.get("started_with") or {}
    for path in (ws.get("repo_root"), started.get("cwd")):
        if path:
            base = os.path.basename(os.path.normpath(str(path)))
            if base:
                return base
    return None


def session_list_entry(s):
    status = s["status"]
    created_by = s.get("created_by") or {}
    ref = s["agent"].get("harness_session_ref")
    return {
        "id": s["id"], "name": s["name"], "agent": {"kind": s["agent"]["kind"]},
        "status": {"state": status["state"], "since": status["since"],
                   "source": status.get("source"), "detail": status.get("detail")},
        "owner": s["owner"]["actor"],
        "workspace": {"branch": (s.get("workspace") or {}).get("branch")},
        "needs_attention": status["state"] in NEEDS_ATTENTION_STATES,
        "children": len(s["lineage"]["children"]),
        "state_version": s["state_version"],
        # Panel-facing additions (03-sessions-panel.md's row: what, who,
        # where, and whether `open` can resume a transcript).
        "goal": goal_first_line(s.get("goal")),
        "mode": s["mode"],
        "resumable": isinstance(ref, str) and bool(ref),
        "created_by": {"kind": created_by.get("kind"), "label": created_by.get("label")},
        "project": session_project(s),
        # 09-closed-loop-surfaces.md section 7: the registered preview and
        # the loop count ("<n> instructions, <m> captures").
        "preview": s.get("preview"),
        "loop": loop_counts(s),
        # 11-agent-lanes.md: a lane child names its lane and session; a
        # session lists its lanes (filled in by cmd_list from the loaded set).
        "lane": ({"name": s["lane"]["name"], "parent_id": s["lane"]["parent_id"], "parent_name": s["lane"].get("parent_name")}
                 if is_lane(s) else None),
        "lanes": [],
    }


def attach_lane_entries(entries, sessions):
    """Fill each session entry's `lanes` from the loaded set, main first."""
    by_id = {s["id"]: s for s in sessions}
    for e in entries:
        s = by_id.get(e["id"])
        if s is None or is_lane(s):
            continue
        lanes = [by_id[c] for c in s["lineage"]["children"] if c in by_id and is_lane(by_id[c])]
        if lanes:
            e["lanes"] = [lane_summary(c) for c in lanes]
    return entries


def loop_counts(s):
    """Instructions delivered and captures attached, from events.jsonl;
    the store is reached through the session's own directory so this stays
    usable from `list` without a context."""
    try:
        store = SessionStore(sessions_root())
        events = store.read_events(s["id"])
    except Exception:
        return {"instructions": 0, "captures": 0}
    instructions = sum(1 for e in events if e.get("type") == "instruction.delivered")
    captures = sum(1 for e in events if e.get("type") == "artifact.added"
                   and str((e.get("data") or {}).get("path", "")).lower().endswith((".png", ".jpg", ".jpeg", ".webp")))
    return {"instructions": instructions, "captures": captures}


def cmd_new(args, ctx):
    kind = args.agent
    mode = args.mode
    if mode is None:
        mode = "shared" if args.from_session else "personal"

    # --cwd defaults to "." in the parser; resolve it first so the default
    # name can use the real directory's basename rather than ".".
    cwd = str(pathlib.Path(args.cwd or os.getcwd()).resolve())
    name = args.name or default_session_name(
        kind, cwd=cwd, prompt=getattr(args, "prompt", None),
        existing_names={s["name"] for s in ctx.store.list_sessions()},
    )
    if ctx.store.name_taken(name):
        raise ConflictError(f"session name '{name}' is already in use by a live session")

    created_by = agent_actor(args.from_session) if args.from_session else current_human_actor()
    owner = parse_actor_string(args.owner) if args.owner else created_by

    parent = None
    if args.from_session:
        parent = ctx.store.try_load(args.from_session)
        if parent is None:
            raise NotFoundError(f"--from session '{args.from_session}' not found")
        if compute_depth(ctx.store, args.from_session) + 1 > MAX_LINEAGE_DEPTH:
            raise ConflictError(f"lineage depth limit ({MAX_LINEAGE_DEPTH}) exceeded")
        if len(parent["lineage"]["children"]) >= MAX_CHILDREN:
            raise ConflictError(f"children-per-session limit ({MAX_CHILDREN}) exceeded")

    # Validate the harness/mode combination and the deny-list before
    # creating anything on disk (extra agent args count toward invariant 5).
    extra_args = list(getattr(args, "extra_args", []) or [])
    argv, env, cell = assemble_launch(kind, mode, extra_args)

    session_id = new_ulid()
    workspace = resolve_workspace(cwd, name, args.worktree, args.no_worktree, ctx.herdr, base=getattr(args, "base", None))
    herdr_root_pane = workspace.pop("_herdr_root_pane", None) or {}
    if args.worktree:
        check_invariant6(ctx.store, workspace, workspace["created_by_session"])

    command_str = "omarchy-agent-session-core " + getattr(args, "raw_command", "new")
    record = new_session_record(
        session_id, name, created_by, owner, mode, kind, workspace, cwd, command_str,
        goal_text=args.goal, parent_id=args.from_session, spawn_reason="agent_spawn" if args.from_session else None,
    )
    ctx.store.append_event(session_id, "session.created", created_by, {"name": name, "agent": {"kind": kind}, "mode": mode})
    record["state_version"] = 1
    ctx.store.save_session(record)

    if args.goal:
        ev = ctx.store.append_event(session_id, "goal.set", created_by, {"text": args.goal})
        record["state_version"] = ev["seq"]
        ctx.store.save_session(record)

    if parent is not None:
        parent["lineage"]["children"].append(session_id)
        pev = ctx.store.append_event(args.from_session, "child.spawned", created_by,
                                      {"child_id": session_id, "agent": {"kind": kind}, "spawn_reason": "agent_spawn"})
        parent["state_version"] = pev["seq"]
        ctx.store.save_session(parent)
        add_watcher(ctx.store, record, parent["id"])  # pattern 06: a parent watches what it spawned

    # Start the harness through Herdr. A session record now exists whether
    # or not this succeeds (invariant 1); on HerdrUnavailable the session is
    # left in `starting` with no runtime rather than fabricating a `failed`
    # transition neither Herdr nor a human actually reported (see
    # README-core.md).
    alias = derive_herdr_alias(name, session_id)
    try:
        result = ctx.herdr.agent_start(
            alias=alias, kind=kind, cwd=workspace["worktree_path"], flags=argv, env=env, focus=False,
            session_id=session_id, pane_id=herdr_root_pane.get("pane_id"),
        )
        if herdr_root_pane.get("pane_id"):
            result["workspace_id"] = result.get("workspace_id") or herdr_root_pane.get("workspace_id")
            result["tab_id"] = result.get("tab_id") or herdr_root_pane.get("tab_id")
    except HerdrUnavailable as e:
        eprint(f"session {session_id} created but not started: {e}")
        raise
    except HerdrError as e:
        eprint(f"session {session_id} created but Herdr refused agent.start: {e}")
        raise ConflictError(str(e)) from e

    result = result or {}
    runtime = {
        "backend": "herdr", "session": result.get("session"),
        "workspace_id": result.get("workspace_id"), "tab_id": result.get("tab_id"),
        "pane_id": result.get("pane_id"), "agent_id": result.get("agent_id"),
    }
    ev = ctx.store.append_event(session_id, "runtime.bound", created_by, runtime)
    record["runtime"] = runtime
    record["state_version"] = ev["seq"]
    ctx.store.save_session(record)

    # No persistent events.subscribe loop runs inside this CLI process; a
    # successful agent.start is treated as the "Herdr confirms the agent
    # appeared" trigger, moving straight to working (see README-core.md).
    ev = ctx.store.append_event(session_id, "status.changed", agent_actor(session_id, "herdr"),
                                 {"from": "starting", "to": "working", "source": "herdr-hook", "detail": None})
    record["status"] = {"state": "working", "since": ev["ts"], "source": "herdr-hook", "detail": None}
    record["state_version"] = ev["seq"]
    ctx.store.save_session(record)

    prompt = getattr(args, "prompt", None)
    if prompt:
        send_args = argparse.Namespace(id_or_name=session_id, text=prompt, from_session=None,
                                       about_artifact=None, wait=False, until=[], timeout=None)
        try:
            cmd_send(send_args, ctx)
        except (HerdrUnavailable, HerdrError, ConflictError) as e:
            eprint(f"session {session_id} started; first prompt stays queued: {e}")

    if args.json:
        print(json.dumps(record, indent=2))
    else:
        print(session_id)
    return EXIT_OK


# --------------------------------------------------------------------------
# Watchers (06-event-driven-state, pattern 06)
# --------------------------------------------------------------------------

def watch_material(event):
    t = event.get("type")
    if t in WATCH_SILENT_TYPES:
        return False
    if t == "status.changed":
        return (event.get("data") or {}).get("to") in WATCH_MATERIAL_STATES
    return t in WATCH_MATERIAL_TYPES


def add_watcher(store, watched, watcher_id):
    """`watcher_id` follows `watched` from its current last event on."""
    watchers = watched.get("watchers") or []
    if any(w.get("session_id") == watcher_id for w in watchers):
        return watched
    watchers.append({"session_id": watcher_id, "cursor": store._last_seq(watched["id"])})
    watched["watchers"] = watchers
    store.save_session(watched)
    return watched


def remove_watcher(store, watched, watcher_id):
    watched["watchers"] = [w for w in (watched.get("watchers") or []) if w.get("session_id") != watcher_id]
    store.save_session(watched)
    return watched


def _watch_summary(event):
    t, d = event["type"], event.get("data") or {}
    if t == "status.changed":
        return f"{d.get('from')} -> {d.get('to')}" + (f" ({d.get('detail')})" if d.get("detail") else "")
    if t == "artifact.added":
        return f"artifact {d.get('label')}"
    if t == "session.ended":
        return f"ended {d.get('state')} ({d.get('reason')})"
    if t == "lane.merged":
        return f"lane {d.get('lane')} merged {len(d.get('commits') or [])} commit(s)"
    if t == "child.completed":
        return f"{d.get('lane') or d.get('child_id')} finished {d.get('state')}"
    return t


def notify_watchers(store, watched_id, event):
    """Called from append_event. One pending watch instruction per watcher,
    coalesced: a second event before delivery updates the pending text and
    its `seq_to`; delivery (reconcile, or the watcher's own open) advances
    the cursor. Never raises: a watcher that cannot be updated is skipped."""
    try:
        watched = store.try_load(watched_id)
    except Exception:
        return
    if not watched:
        return
    watchers = watched.get("watchers") or []
    if not watchers:
        return
    for w in watchers:
        wid = w.get("session_id")
        watcher = store.try_load(wid) if wid else None
        if watcher is None or watcher["status"]["state"] in TERMINAL_STATES:
            continue
        pending = next((q for q in watcher.get("queue") or [] if q.get("delivery") == "watch" and q.get("origin_session") == watched_id), None)
        summary = _watch_summary(event)
        if pending is not None:
            pending["seq_to"] = event["seq"]
            pending["count"] = int(pending.get("count") or 1) + 1
            pending["text"] = f"{summary} ({pending['count']} events since seq {pending['seq_from']})"
            store.save_session(watcher)
            continue
        instr = new_instruction(summary, agent_actor(watched_id, label=watched["name"]),
                                delivery="watch", origin_session=watched_id)
        instr["seq_from"] = int(w.get("cursor") or 0)
        instr["seq_to"] = event["seq"]
        instr["count"] = 1
        ev = store.append_event(wid, "instruction.queued", instr["author"], instr)
        watcher["queue"].append(instr)
        watcher["state_version"] = ev["seq"]
        store.save_session(watcher)


def deliver_pending(session, ctx, only_delivery=None):
    """Deliver the session's queued instructions in order through Herdr,
    advancing watch cursors as watch instructions land. Returns the number
    delivered. Used by `open` after a bind and by the reconciler for live
    sessions; a delivery that fails leaves the instruction queued."""
    runtime = session.get("runtime")
    if runtime is None or ctx.herdr is None:
        return 0
    pending = [q for q in list(session.get("queue") or []) if only_delivery is None or q.get("delivery") == only_delivery]
    if not pending:
        return 0
    alias = derive_herdr_alias(session["name"], session["id"])
    if not wait_interactive_ready(ctx.herdr, alias, timeout_s=10.0):
        return 0
    delivered = 0
    for instr in pending:
        origin = instr.get("origin_session")
        text = instr["text"]
        if origin:
            origin_rec = ctx.store.try_load(origin)
            text = format_marked_instruction(origin, origin_rec["name"] if origin_rec else origin, instr["text"])
        try:
            ctx.herdr.agent_prompt(alias=alias, text=text, wait=False)
        except (HerdrError, HerdrUnavailable):
            break
        ev = ctx.store.append_event(session["id"], "instruction.delivered", instr["author"],
                                     {"instruction_id": instr["id"], "delivery": instr.get("delivery") or "steer"})
        session["queue"] = [q for q in session["queue"] if q["id"] != instr["id"]]
        session["state_version"] = ev["seq"]
        ctx.store.save_session(session)
        delivered += 1
        if instr.get("delivery") == "watch" and origin:
            watched = ctx.store.try_load(origin)
            if watched is not None:
                for w in watched.get("watchers") or []:
                    if w.get("session_id") == session["id"]:
                        w["cursor"] = int(instr.get("seq_to") or w.get("cursor") or 0)
                ctx.store.save_session(watched)
    return delivered


def cmd_subscribe(args, ctx):
    watched = ctx.store.load(args.id_or_name)
    watcher = ctx.store.load(args.watcher)
    if watcher["id"] == watched["id"]:
        raise UsageError("a session cannot watch itself")
    if args.remove:
        remove_watcher(ctx.store, watched, watcher["id"])
        print(f"{watcher['name']} no longer watches {watched['name']}")
    else:
        add_watcher(ctx.store, watched, watcher["id"])
        print(f"{watcher['name']} watches {watched['name']} from seq {ctx.store._last_seq(watched['id'])}")
    return EXIT_OK


# --------------------------------------------------------------------------
# Lanes (11-agent-lanes.md): several agents on one goal inside one session
# --------------------------------------------------------------------------

def is_lane(session):
    return bool(session.get("lane")) and (session.get("lineage") or {}).get("spawn_reason") == "lane"


def lane_children(store, session):
    """The session's lanes, in the order they were added, as loaded records."""
    out = []
    for child_id in (session.get("lineage") or {}).get("children") or []:
        child = store.try_load(child_id)
        if child is not None and is_lane(child):
            out.append(child)
    return out


def live_lane_children(store, session):
    return [c for c in lane_children(store, session)
            if c["status"]["state"] not in TERMINAL_STATES and c["status"]["state"] != "orphaned"]


def lane_name_taken(store, session, lane_name):
    if lane_name == LANE_MAIN:
        return True
    return any(c["lane"]["name"] == lane_name for c in lane_children(store, session))


def default_lane_name(store, session, kind):
    base = git_safe_ref(kind) or "lane"
    if not lane_name_taken(store, session, base):
        return base
    n = 2
    while lane_name_taken(store, session, f"{base}-{n}"):
        n += 1
    return f"{base}-{n}"


def resolve_lane(store, session, lane_name):
    """A lane name to its record; `main` (or None) is the session itself."""
    if lane_name in (None, "", LANE_MAIN):
        return session
    for child in lane_children(store, session):
        if child["lane"]["name"] == lane_name:
            return child
    raise NotFoundError(f"session '{session['name']}' has no lane '{lane_name}'")


def lane_workspace(parent, lane_name, share):
    """The lane's own worktree on session/<name>/<lane>, cut from the
    session's branch, so two agents never edit one tree at once. Sharing
    the session's worktree is the explicit exception (--share-worktree),
    and the only choice when the session has no branch of its own."""
    ws = parent.get("workspace") or {}
    if share or not ws.get("branch") or not ws.get("repo_root"):
        return {"repo_root": ws.get("repo_root"), "worktree_path": ws.get("worktree_path"),
                "branch": ws.get("branch"), "base_branch": ws.get("base_branch"),
                "created_by_session": False, "shared_with_session": True}
    repo_root = ws["repo_root"]
    # Git refs cannot nest under an existing branch name (session/x and
    # session/x/lane cannot both exist), so the lane branch sits beside the
    # session branch: session/<name>--<lane>.
    branch = f"{ws['branch']}--{git_safe_ref(lane_name)}"
    dest = herdr_worktrees_directory() / f"{git_safe_ref(parent['name'])}--{git_safe_ref(lane_name)}"
    dest.parent.mkdir(parents=True, exist_ok=True)
    # Plain git here on purpose: Herdr's worktree.create opens a workspace
    # per worktree, and a lane lives as a pane inside the session's one
    # workspace (11-agent-lanes.md).
    run_git(["worktree", "add", str(dest), "-b", branch, ws["branch"]], cwd=repo_root)
    return {"repo_root": repo_root, "worktree_path": str(dest), "branch": branch,
            "base_branch": ws["branch"], "created_by_session": True, "shared_with_session": False}


def lane_summary(child):
    st = child["status"]
    return {
        "lane": child["lane"]["name"], "id": child["id"], "kind": child["agent"]["kind"],
        "state": st["state"], "since": st["since"], "detail": st.get("detail"),
        "task": goal_first_line(child.get("goal")),
        "mode": child.get("mode"), "branch": (child.get("workspace") or {}).get("branch"),
        "worktree": (child.get("workspace") or {}).get("worktree_path"),
        "needs_attention": st["state"] in NEEDS_ATTENTION_STATES,
        "resumable": bool(child["agent"].get("harness_session_ref")),
    }


def cmd_add(args, ctx):
    """Pull another agent into a live session with its own task."""
    parent = ctx.store.load(args.id_or_name)
    if is_lane(parent):
        raise ConflictError(f"'{parent['name']}' is a lane; add lanes to its session instead")
    pstate = parent["status"]["state"]
    if pstate in TERMINAL_STATES:
        raise ConflictError(f"session '{parent['name']}' has ended ({pstate}); start a new one")
    if parent.get("runtime") is None:
        raise ConflictError(f"session '{parent['name']}' has no running workspace; open (revive) it first")
    if compute_depth(ctx.store, parent["id"]) + 1 > MAX_LINEAGE_DEPTH:
        raise ConflictError(f"lineage depth limit ({MAX_LINEAGE_DEPTH}) exceeded")
    if len(parent["lineage"]["children"]) >= MAX_CHILDREN:
        raise ConflictError(f"a session holds at most {MAX_CHILDREN} lanes")

    kind = args.agent
    lane_name = args.lane or default_lane_name(ctx.store, parent, kind)
    if lane_name == LANE_MAIN or not git_safe_ref(lane_name) or lane_name_taken(ctx.store, parent, lane_name):
        raise ConflictError(f"lane name '{lane_name}' is taken or reserved in session '{parent['name']}'")
    mode = args.mode or parent["mode"]
    if MODE_RANK[mode] < MODE_RANK[parent["mode"]]:
        raise ConflictError(f"a lane may be stricter than its session, never looser: session is {parent['mode']}, lane asked for {mode}")
    argv, env, _cell = assemble_launch(kind, mode, [])

    actor = current_human_actor()
    child_id = new_ulid()
    name = f"{parent['name']}.{lane_name}"
    workspace = lane_workspace(parent, lane_name, args.share_worktree)
    command_str = "omarchy-agent-session-core " + getattr(args, "raw_command", "add")
    record = new_session_record(
        child_id, name, actor, actor, mode, kind, workspace, workspace["worktree_path"], command_str,
        goal_text=args.task, parent_id=parent["id"], spawn_reason="lane",
        lane={"name": lane_name, "parent_id": parent["id"], "parent_name": parent["name"]},
    )
    ctx.store.append_event(child_id, "session.created", actor, {"name": name, "agent": {"kind": kind}, "mode": mode, "lane": lane_name})
    record["state_version"] = 1
    ctx.store.save_session(record)
    if args.task:
        ev = ctx.store.append_event(child_id, "goal.set", actor, {"text": args.task})
        record["state_version"] = ev["seq"]
        ctx.store.save_session(record)

    parent["lineage"]["children"].append(child_id)
    pev = ctx.store.append_event(parent["id"], "child.spawned", actor,
                                  {"child_id": child_id, "agent": {"kind": kind}, "spawn_reason": "lane"})
    add_watcher(ctx.store, record, parent["id"])  # pattern 06: a parent watches what it spawned
    pev = ctx.store.append_event(parent["id"], "lane.added", actor,
                                  {"lane": lane_name, "child_id": child_id, "agent": {"kind": kind}, "task": args.task, "mode": mode})
    parent["state_version"] = pev["seq"]
    ctx.store.save_session(parent)

    # A pane beside the session's own, in its workspace, then the harness in it.
    prt = parent["runtime"]
    alias = derive_herdr_alias(name, child_id)
    try:
        pane = ctx.herdr.pane_split(workspace_id=prt.get("workspace_id"), target_pane_id=prt.get("pane_id"),
                                    cwd=workspace["worktree_path"], direction=args.direction, focus=False)
        result = ctx.herdr.agent_start(alias=alias, kind=kind, cwd=workspace["worktree_path"], flags=argv, env=env,
                                       focus=False, session_id=child_id, pane_id=pane.get("pane_id"))
        result["workspace_id"] = result.get("workspace_id") or pane.get("workspace_id") or prt.get("workspace_id")
        result["tab_id"] = result.get("tab_id") or pane.get("tab_id") or prt.get("tab_id")
    except HerdrUnavailable as e:
        eprint(f"lane {lane_name} created but not started: {e}")
        raise
    except HerdrError as e:
        eprint(f"lane {lane_name} created but Herdr refused: {e}")
        raise ConflictError(str(e)) from e
    with contextlib.suppress(HerdrError, HerdrUnavailable):
        ctx.herdr.call("pane.report_metadata", {"pane_id": result.get("pane_id"), "source": "omarchy-agent-session",
                                                "title": f"{parent['name']} · {lane_name}",
                                                "tokens": {"session_id": child_id, "lane": lane_name, "parent_session_id": parent["id"]}})

    runtime = {"backend": "herdr", "session": None, "workspace_id": result.get("workspace_id"),
               "tab_id": result.get("tab_id"), "pane_id": result.get("pane_id"), "agent_id": result.get("agent_id")}
    ev = ctx.store.append_event(child_id, "runtime.bound", actor, runtime)
    record["runtime"] = runtime
    record["state_version"] = ev["seq"]
    ev = ctx.store.append_event(child_id, "status.changed", agent_actor(child_id, "herdr"),
                                 {"from": "starting", "to": "working", "source": "herdr-hook", "detail": None})
    record["status"] = {"state": "working", "since": ev["ts"], "source": "herdr-hook", "detail": None}
    record["state_version"] = ev["seq"]
    ctx.store.save_session(record)

    # The task is the lane's first instruction.
    if args.task:
        send_args = argparse.Namespace(id_or_name=child_id, text=args.task, from_session=None, about_artifact=None,
                                       wait=False, until=[], timeout=None, lane=None, with_capture=False)
        try:
            cmd_send(send_args, ctx)
        except (HerdrUnavailable, HerdrError, ConflictError) as e:
            eprint(f"lane {lane_name} started; its task stays queued: {e}")

    if args.json:
        print(json.dumps(record, indent=2))
    else:
        print(child_id)
    return EXIT_OK


def cmd_lanes(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if is_lane(session):
        session = ctx.store.load(session["lane"]["parent_id"])
    rows = [{"lane": LANE_MAIN, "id": session["id"], "kind": session["agent"]["kind"],
             "state": session["status"]["state"], "since": session["status"]["since"],
             "detail": session["status"].get("detail"),
             "task": goal_first_line(session.get("goal")), "mode": session.get("mode"),
             "branch": (session.get("workspace") or {}).get("branch"),
             "worktree": (session.get("workspace") or {}).get("worktree_path"),
             "needs_attention": session["status"]["state"] in NEEDS_ATTENTION_STATES,
             "resumable": bool(session["agent"].get("harness_session_ref"))}]
    rows += [lane_summary(c) for c in lane_children(ctx.store, session)]
    if args.json:
        print(json.dumps({"session": session["id"], "name": session["name"], "lanes": rows}, indent=2))
    else:
        for r in rows:
            print(f"{r['lane']:<12} {r['kind']:<9} {r['state']:<9} {r['task'] or ''}")
    return EXIT_OK


def merge_lane_into_session(store, parent, child, actor):
    """`done --lane <name> --verdict kept`: the lane's branch lands on the
    session's branch, in the session's worktree. A clean merge records
    lane.merged with the commits; a conflict leaves the merge aborted,
    the lane blocked with the reason, and nothing lost."""
    cws, pws = child.get("workspace") or {}, parent.get("workspace") or {}
    if cws.get("shared_with_session") or not cws.get("branch") or not pws.get("worktree_path"):
        return {"merged": False, "reason": "shared worktree", "commits": []}
    parent_wt, parent_branch, lane_branch = pws["worktree_path"], pws.get("branch"), cws["branch"]
    if not parent_branch or not pathlib.Path(parent_wt).exists():
        return {"merged": False, "reason": "session worktree missing", "commits": []}
    before = run_git(["rev-parse", "HEAD"], cwd=parent_wt).stdout.strip()
    r = run_git(["merge", "--no-edit", lane_branch], cwd=parent_wt, check=False)
    if r.returncode != 0:
        run_git(["merge", "--abort"], cwd=parent_wt, check=False)
        return {"merged": False, "reason": "merge conflict", "commits": [], "output": (r.stderr or r.stdout or "").strip()[-400:]}
    after = run_git(["rev-parse", "HEAD"], cwd=parent_wt).stdout.strip()
    log = run_git(["log", "--no-merges", "--format=%H", f"{before}..{after}"], cwd=parent_wt, check=False)
    commits = [l for l in (log.stdout or "").splitlines() if l]
    ev = store.append_event(parent["id"], "lane.merged", actor,
                            {"lane": child["lane"]["name"], "child_id": child["id"], "branch": lane_branch,
                             "into": parent_branch, "commits": commits, "range": f"{before[:7]}..{after[:7]}"})
    parent["state_version"] = ev["seq"]
    store.save_session(parent)
    return {"merged": True, "reason": None, "commits": commits, "range": f"{before[:7]}..{after[:7]}"}


def notify_parent_of_completion(store, herdr, child, end_state, reason):
    """The completion path every child session has (01-session-model.md):
    the parent records child.completed and, when its own harness is live,
    receives a marked instruction so its agent learns the outcome without
    polling."""
    parent_id = (child.get("lineage") or {}).get("parent_id")
    if not parent_id:
        return
    parent = store.try_load(parent_id)
    if parent is None:
        return
    actor = agent_actor(child["id"], label=child["name"])
    lane = (child.get("lane") or {}).get("name")
    ev = store.append_event(parent_id, "child.completed", actor,
                            {"child_id": child["id"], "lane": lane, "state": end_state, "reason": reason})
    parent["state_version"] = ev["seq"]
    store.save_session(parent)
    if parent["status"]["state"] in TERMINAL_STATES or parent.get("runtime") is None or herdr is None:
        return
    who = f"lane {lane}" if lane else f"child session {child['name']}"
    text = f"{who} finished: {end_state} ({reason})."
    send_args = argparse.Namespace(id_or_name=parent_id, text=text, from_session=child["id"], about_artifact=None,
                                   wait=False, until=[], timeout=None, lane=None, with_capture=False)
    with contextlib.suppress(Exception):
        cmd_send(send_args, Context(store, herdr))


def cmd_list(args, ctx):
    sessions = ctx.store.list_sessions()
    if args.state:
        sessions = [s for s in sessions if s["status"]["state"] == args.state]
    if args.mine:
        me = current_human_actor()
        sessions = [s for s in sessions if s["owner"]["actor"].get("id") == me["id"]]
    sessions.sort(key=lambda s: s["created_at"])
    everything = ctx.store.list_sessions()
    entries = attach_lane_entries([session_list_entry(s) for s in sessions], everything)
    if args.json:
        print(json.dumps({"sessions": entries}, indent=2))
        return EXIT_OK
    for entry in entries:
        flag = "!" if entry["needs_attention"] else " "
        lane = f"  lane {entry['lane']['name']} of {entry['lane'].get('parent_name') or entry['lane']['parent_id']}" if entry.get("lane") else ""
        print(f"{flag} {entry['id']}  {entry['name']:<24} {entry['status']['state']:<10} {entry['agent']['kind']}{lane}")
    return EXIT_OK


def cmd_show(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if args.refresh:
        try:
            live = ctx.herdr.agent_get(agent_id=(session.get("runtime") or {}).get("agent_id"))
        except HerdrUnavailable as e:
            raise
        else:
            live_state = (live or {}).get("state")
            if live_state and live_state != session["status"]["state"]:
                ev = ctx.store.append_event(session["id"], "status.changed", system_actor(),
                                             {"from": session["status"]["state"], "to": live_state,
                                              "source": "herdr-hook", "detail": None})
                session["status"] = {"state": live_state, "since": ev["ts"], "source": "herdr-hook", "detail": None}
                session["state_version"] = ev["seq"]
                ctx.store.save_session(session)

    if args.loop:
        print(render_loop_text(ctx.store, session))
        return EXIT_OK

    if args.json:
        entry = session_list_entry(session)
        entry.update({
            "goal": session.get("goal"), "runtime": session.get("runtime"),
            "lineage": session.get("lineage"), "created_at": session["created_at"],
            "created_by": session["created_by"], "mode": session["mode"],
            "started_with": session["started_with"],
            "recent_events": ctx.store.read_events(session["id"])[-20:],
        })
        print(json.dumps({"session": entry}, indent=2))
    else:
        print(json.dumps(session, indent=2))
    return EXIT_OK


def render_loop_text(store, session):
    """09-closed-loop-surfaces.md section 4: the intent, then every
    instruction in order with the artifact it was about, every change
    (the commits on the session's branch), every capture and note, the
    state changes, and the verdict, all in the order they happened. Nothing
    computed specially: events.jsonl and the git log, joined and sorted."""
    lines = []
    goal = (session.get("goal") or {}).get("text") or ""
    lines.append("Intent")
    if goal.strip():
        for g in goal.strip().splitlines():
            lines.append(f"  {g}")
    else:
        lines.append("  (no goal set)")
    preview = session.get("preview")
    if preview:
        lines.append(f"Preview  {preview.get('kind')}: {preview.get('value')}")
    lines.append("")

    events = store.read_events(session["id"])
    # Artifact labels by path, so an instruction's `about` reads as a label.
    artifacts = read_artifacts_index(store.artifacts_dir(session["id"]))
    label_by_path = {a.get("path"): a.get("label") for a in artifacts}
    label_by_ulid = {}
    for a in artifacts:
        stem = pathlib.Path(a.get("path", "")).name
        label_by_ulid[stem.split("-", 1)[0]] = a.get("label")

    def about_label(ref):
        if not ref:
            return None
        return label_by_path.get(ref) or label_by_ulid.get(ref) or ref

    # (ts, seq, text): within one second the record's own order wins, so
    # the capture an instruction is about lists before the instruction
    # (run 4, 2026-09-03); commits carry seq 0 and lead their second.
    rows = []
    for e in events:
        t, d = e["type"], e.get("data") or {}
        ts = e["ts"]
        if t == "instruction.queued":
            about = about_label(d.get("about_artifact"))
            who = (e.get("actor") or {}).get("label") or (e.get("actor") or {}).get("id") or "?"
            text = (d.get("text") or "").strip().splitlines()[0] if d.get("text") else ""
            rows.append((ts, int(e.get("seq") or 0), f"instruction  {who}: {text}" + (f"  [about: {about}]" if about else "")))
        elif t == "instruction.dropped":
            rows.append((ts, int(e.get("seq") or 0), f"dropped      {d.get('reason')}"))
        elif t == "artifact.added":
            what = d.get("path")
            if d.get("url"):
                what = d["url"]
            state = f"  [{d.get('state')}]" if d.get("state") and d.get("state") != "proposed" else ""
            rows.append((ts, int(e.get("seq") or 0), f"artifact     {d.get('label')}  {what}{state}"))
        elif t == "artifact.updated":
            rows.append((ts, int(e.get("seq") or 0), f"artifact     {d.get('label')}  marked {d.get('state')}"))
        elif t == "status.changed":
            detail = f"  ({d.get('detail')})" if d.get("detail") else ""
            rows.append((ts, int(e.get("seq") or 0), f"state        {d.get('from')} -> {d.get('to')}{detail}"))
        elif t == "session.ended":
            rows.append((ts, int(e.get("seq") or 0), f"ended        {d.get('state')}  {d.get('reason')}"))
        elif t == "lane.added":
            rows.append((ts, int(e.get("seq") or 0), f"lane         {d.get('lane')} added ({(d.get('agent') or {}).get('kind')}): {(d.get('task') or '').strip().splitlines()[0] if d.get('task') else ''}"))
        elif t == "lane.merged":
            rows.append((ts, int(e.get("seq") or 0), f"lane         {d.get('lane')} merged {len(d.get('commits') or [])} commit(s) {d.get('range')} into {d.get('into')}"))
        elif t == "child.completed":
            rows.append((ts, int(e.get("seq") or 0), f"lane         {d.get('lane') or d.get('child_id')} ended {d.get('state')} ({d.get('reason')})"))
    ws = session.get("workspace") or {}
    git_cwd = ws.get("worktree_path") if ws.get("worktree_path") and pathlib.Path(ws["worktree_path"]).exists() else ws.get("repo_root")
    if git_cwd and ws.get("base_branch") and ws.get("branch"):
        r = run_git(["log", "--no-merges", "--reverse", "--format=%H\x1f%cI\x1f%s", f"{ws['base_branch']}..{ws['branch']}"],
                    cwd=git_cwd, check=False)
        if r.returncode == 0:
            for line in r.stdout.splitlines():
                parts = line.split("\x1f")
                if len(parts) == 3:
                    sha, when, subject = parts
                    try:
                        ts = dt.datetime.fromisoformat(when).astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                    except ValueError:
                        ts = when
                    rows.append((ts, 0, f"change       {sha[:7]} {subject}"))
    rows.sort(key=lambda r: (r[0], r[1]))
    for ts, _k, text in rows:
        lines.append(f"{ts}  {text}")
    return "\n".join(lines)


def _release_runtime(session, herdr, reason):
    """Close the session's Herdr pane, courtesy interrupt first, and drop the
    binding. Shared by `stop` and `done`."""
    runtime = session.get("runtime")
    if runtime is None:
        return False
    if session["status"]["state"] != "orphaned":
        alias = derive_herdr_alias(session["name"], session["id"])
        with contextlib.suppress(HerdrError):
            herdr.call("agent.send_keys", {"target": alias, "keys": ["ctrl+c"]})
        herdr.pane_close(pane_id=runtime.get("pane_id"))  # let HerdrUnavailable propagate
    return True


INFERRED_EXIT_PREFIX = "harness exited"


def inferred_exit_revivable(session):
    """An ended session whose end the reconciler inferred from a vanished
    harness ("harness exited", "harness exited while working"), with a
    transcript to resume: nobody decided it was over, so Enter revives it
    the way an orphaned session revives (a reboot before the restart rule
    existed ended sessions this way, rig 2026-09-02)."""
    st = session["status"]
    return (st["state"] in ("done", "failed")
            and str(st.get("detail") or "").startswith(INFERRED_EXIT_PREFIX)
            and bool(session["agent"].get("harness_session_ref")))


def cmd_open(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if getattr(args, "lane", None):
        session = resolve_lane(ctx.store, session, args.lane)
    actor = current_human_actor()
    state = session["status"]["state"]
    runtime = session.get("runtime")

    if inferred_exit_revivable(session):
        detail = "reopened after an inferred exit"
        ev = ctx.store.append_event(session["id"], "status.changed", actor,
                                     {"from": state, "to": "orphaned", "source": "omarchy", "detail": detail})
        session["status"] = {"state": "orphaned", "since": ev["ts"], "source": "omarchy", "detail": detail}
        session["state_version"] = ev["seq"]
        ctx.store.save_session(session)
        state = "orphaned"

    if state == "orphaned":
        ref = session["agent"].get("harness_session_ref")
        worktree_path = (session.get("workspace") or {}).get("worktree_path")
        argv, env, _cell = assemble_launch(session["agent"]["kind"], session["mode"])
        detail = None
        if ref:
            argv = list(RESUME_FLAGS.get(session["agent"]["kind"], ["--resume"])) + [ref] + argv
        else:
            detail = "no transcript to resume"
        alias = derive_herdr_alias(session["name"], session["id"])
        result = ctx.herdr.agent_start(alias=alias, kind=session["agent"]["kind"],
                                        cwd=worktree_path, flags=argv, env=env, focus=False,
                                        session_id=session["id"])
        result = result or {}
        new_runtime = {"backend": "herdr", "session": result.get("session"),
                       "workspace_id": result.get("workspace_id"), "tab_id": result.get("tab_id"),
                       "pane_id": result.get("pane_id"), "agent_id": result.get("agent_id")}
        ev = ctx.store.append_event(session["id"], "runtime.bound", actor, new_runtime)
        session["runtime"] = new_runtime
        session["state_version"] = ev["seq"]
        ev = ctx.store.append_event(session["id"], "status.changed", actor,
                                     {"from": "orphaned", "to": "working", "source": "omarchy", "detail": detail})
        session["status"] = {"state": "working", "since": ev["ts"], "source": "omarchy", "detail": detail}
        session["state_version"] = ev["seq"]
        ctx.store.save_session(session)
        runtime = new_runtime  # fall through: a revived session gets its terminal too (rig, 2026-09-02)
    if runtime is not None:
        # Bound and live: confirm the binding, then attach a terminal.
        ctx.herdr.agent_get(agent_id=runtime.get("agent_id"))
        alias = derive_herdr_alias(session["name"], session["id"])
        # Detached: the launcher execs the terminal and only returns when the
        # window closes, which blocked `open` for the window's lifetime
        # (rig, 2026-09-02).
        with contextlib.suppress(FileNotFoundError, OSError):
            subprocess.Popen(["omarchy-launch-or-focus-tui", f"--app-id=org.omarchy.session.{session['id']}",
                              "herdr", "agent", "attach", alias],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        # Instructions queued while the session had no runtime ("delivered
        # on revive") and pending watch notices go out now.
        with contextlib.suppress(Exception):
            deliver_pending(ctx.store.load(session["id"]), ctx)
        # 09-closed-loop-surfaces.md section 2: the running product sits
        # beside the conversation. Best effort; a missing compositor or
        # browser costs nothing here.
        with contextlib.suppress(Exception):
            focus_preview(session)
    elif state != "orphaned":
        raise ConflictError(f"session {session['id']} has no runtime and is not orphaned; nothing to open")
    return EXIT_OK


# Per-harness native-resume command, from Herdr's resume table
# (02-command-surface.md gives two examples: claude, codex). Harnesses not
# listed here fall back to a fresh start with detail "no transcript to
# resume" even when harness_session_ref is set -- verify on rig.
RESUME_FLAGS = {
    "claude": ["--resume"],
    "codex": ["resume"],
}


def wait_interactive_ready(herdr, alias, timeout_s=30.0, step_s=0.5):
    """False only when Herdr's agent list keeps reporting the alias with
    `interactive_ready` false until `timeout_s` runs out. An agent that is
    absent from the list, or listed without the flag (older Herdr), is
    left to `agent.prompt`, which fails loudly on its own; a Herdr error
    while polling counts as not ready."""
    deadline = time.monotonic() + timeout_s
    while True:
        try:
            agents = herdr.agent_list()
        except (HerdrError, HerdrUnavailable):
            agents = None
        if agents is not None:
            entry = next((a for a in agents if a.get("agent_id") == alias or a.get("name") == alias), None)
            if entry is None or entry.get("interactive_ready") is not False:
                return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(step_s)


def cmd_send(args, ctx):
    session = ctx.store.load(args.id_or_name)
    lane = getattr(args, "lane", None)
    if lane:
        return _send_one(resolve_lane(ctx.store, session, lane), args, ctx)
    lanes = live_lane_children(ctx.store, session) if not is_lane(session) else []
    if not lanes:
        return _send_one(session, args, ctx)
    # A session with lanes and no --lane: the instruction goes to the
    # session's own agent and every live lane, each as its own record.
    failures = []
    targets = ([session] if session.get("runtime") is not None or not lanes else []) + lanes
    for target in targets:
        try:
            _send_one(target, args, ctx)
        except (ConflictError, HerdrError, HerdrUnavailable) as e:
            failures.append((target.get("lane") or {}).get("name") or LANE_MAIN)
            eprint(f"lane {(target.get('lane') or {}).get('name') or LANE_MAIN}: {e}")
    if failures:
        raise ConflictError("not delivered to: " + ", ".join(failures))
    return EXIT_OK


def _send_one(session, args, ctx):
    if getattr(args, "with_capture", False) and not args.about_artifact:
        # Situated feedback from the panel: grab the preview as it is right
        # now and tie the instruction to that capture.
        path, _hint = capture_preview_to_file(session)
        actor0 = current_human_actor()
        label = f"feedback-{loop_counts(session)['captures'] + 1}"
        entry, _dest = add_artifact(ctx.store, session["id"], "capture", str(path), label, actor0)
        ev = ctx.store.append_event(session["id"], "artifact.added", actor0,
                                     {"path": entry["path"], "label": entry["label"], "added_by": actor0})
        session["state_version"] = ev["seq"]
        ctx.store.save_session(session)
        args.about_artifact = entry["path"]
    if args.from_session:
        origin = ctx.store.try_load(args.from_session)
        origin_name = origin["name"] if origin else args.from_session
        author = agent_actor(args.from_session, label=origin_name)
        delivered_text = format_marked_instruction(args.from_session, origin_name, args.text)
    else:
        author = current_human_actor()
        delivered_text = args.text

    instr = new_instruction(args.text, author, delivery="steer",
                             origin_session=args.from_session, about_artifact=args.about_artifact)
    ev = ctx.store.append_event(session["id"], "instruction.queued", author, instr)
    session["queue"].append(instr)
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)

    runtime = session.get("runtime")
    if runtime is None:
        return EXIT_OK  # stays queued; delivered on the next `open`

    alias = derive_herdr_alias(session["name"], session["id"])
    # A freshly started harness reports `unknown` for a few seconds and
    # rejects prompts as "not an active named agent" (rig, 2026-09-02);
    # wait for a classified state first, bounded, and ignore failures.
    with contextlib.suppress(HerdrError, HerdrUnavailable):
        ctx.herdr.call("agent.wait", {"target": alias, "until": ["idle", "blocked", "done", "working"], "timeout_ms": 15000}, timeout=20)
    # Herdr says `idle` before the harness's input is ready to take text:
    # evaluation run 1 (2026-09-02) delivered a prompt four seconds after
    # creation, Claude never saw it, and the session sat idle with no work
    # done. Herdr's agent list carries `interactive_ready` for exactly
    # this; wait for it, bounded, before typing anything into the pane.
    if not wait_interactive_ready(ctx.herdr, alias):
        ev = ctx.store.append_event(session["id"], "instruction.dropped", author,
                                     {"instruction_id": instr["id"], "reason": "agent_not_ready"})
        session["queue"] = [q for q in session["queue"] if q["id"] != instr["id"]]
        session["state_version"] = ev["seq"]
        ctx.store.save_session(session)
        raise ConflictError("instruction dropped: the harness never became ready for input")
    wait_timed_out = False
    try:
        prompt_result = ctx.herdr.agent_prompt(alias=alias, text=delivered_text, wait=args.wait,
                                               until=args.until, timeout_ms=args.timeout) or {}
    except HerdrError as e:
        if args.wait and "timed out" in str(e).lower():
            # Herdr typed the text and then gave up waiting for the state we
            # asked for; the instruction reached the harness (run 3,
            # 2026-09-02: the commit landed while the wait was still
            # running). Record delivery, say the wait ran out, exit 0.
            wait_timed_out = True
            prompt_result = {}
            print(f"delivered; wait ran out: {e}", file=sys.stderr)
        else:
            ev = ctx.store.append_event(session["id"], "instruction.dropped", author,
                                         {"instruction_id": instr["id"], "reason": "agent_blocked"})
            session["queue"] = [q for q in session["queue"] if q["id"] != instr["id"]]
            session["state_version"] = ev["seq"]
            ctx.store.save_session(session)
            raise ConflictError(f"instruction dropped: {e}") from e

    live_agent = (prompt_result.get("agent") or {}) if isinstance(prompt_result, dict) else {}
    if live_agent.get("agent_status"):
        session = apply_herdr_status(ctx.store, session, live_agent.get("agent_status"))
    record_harness_session_ref(ctx.store, session, ctx.herdr)
    delivered = {"instruction_id": instr["id"], "delivery": "steer"}
    if wait_timed_out:
        delivered["wait_timed_out"] = True
    ev = ctx.store.append_event(session["id"], "instruction.delivered", author, delivered)
    session["queue"] = [q for q in session["queue"] if q["id"] != instr["id"]]
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    return EXIT_OK


def _end_session(session, store, actor, end_state, reason, unbind_reason):
    """Move a live session to a terminal state without touching Herdr:
    status.changed, runtime.unbound, session.ended, then the receipt, in
    the same order `_stop_one` uses. Used by the reconciler when the
    harness has already gone away on its own."""
    session_id = session["id"]
    state = session["status"]["state"]
    ev = store.append_event(session_id, "status.changed", actor,
                            {"from": state, "to": end_state, "source": "reconciler", "detail": reason})
    session["status"] = {"state": end_state, "since": ev["ts"], "source": "reconciler", "detail": reason}
    session["state_version"] = ev["seq"]
    if session.get("runtime") is not None:
        ev = store.append_event(session_id, "runtime.unbound", actor, {"reason": unbind_reason})
        session["runtime"] = None
        session["state_version"] = ev["seq"]
    ev = store.append_event(session_id, "session.ended", actor, {"state": end_state, "reason": reason})
    session["state_version"] = ev["seq"]
    store.save_session(session)
    receipt = compute_receipt(store, session, end_state, reason, session["status"]["since"])
    write_receipt(store, receipt)
    ev = store.append_event(session_id, "receipt.written", actor,
                            {"receipt_summary": {"end_state": end_state, "state_version": receipt["state_version"]}})
    session["state_version"] = ev["seq"]
    store.save_session(session)
    notify_parent_of_completion(store, None, session, end_state, reason)


def _stop_one(session_id, store, herdr, actor, reason):
    session = store.try_load(session_id)
    if session is None:
        return
    state = session["status"]["state"]
    if state in TERMINAL_STATES:
        return
    runtime = session.get("runtime")
    # Record first, close the pane second: the reconciler runs on every
    # Herdr event, and a pane closed before the record says "stopped" reads
    # as an orphan for one tick (run 3, 2026-09-02, `idle -> orphaned` a
    # heartbeat before `idle -> done`).
    ev = store.append_event(session_id, "status.changed", actor, {"from": state, "to": "stopped", "source": actor["kind"], "detail": reason})
    session["status"] = {"state": "stopped", "since": ev["ts"], "source": actor["kind"], "detail": reason}
    session["state_version"] = ev["seq"]
    if runtime is not None:
        ev = store.append_event(session_id, "runtime.unbound", actor, {"reason": "stopped"})
        session["runtime"] = None
        session["state_version"] = ev["seq"]
    store.save_session(session)
    if runtime is not None:
        session["runtime"] = runtime
        session["status"]["state"] = state
        try:
            _release_runtime(session, herdr, reason)
        finally:
            session["runtime"] = None
            session["status"]["state"] = "stopped"
    cleanup_workspace_if_owned(session, herdr)
    ev = store.append_event(session_id, "session.ended", actor, {"state": "stopped", "reason": reason})
    session["state_version"] = ev["seq"]
    store.save_session(session)
    # 05-receipts-and-artifacts.md: the receipt is written at done, failed,
    # and stopped. Verified missing on the rig 2026-09-02; added here.
    receipt = compute_receipt(store, session, "stopped", reason, session["status"]["since"])
    write_receipt(store, receipt)
    ev = store.append_event(session_id, "receipt.written", actor,
                            {"receipt_summary": {"end_state": "stopped", "state_version": receipt["state_version"]}})
    session["state_version"] = ev["seq"]
    store.save_session(session)
    if reason != "parent_stopped":
        notify_parent_of_completion(store, herdr, session, "stopped", reason)


def cmd_stop(args, ctx):
    session = ctx.store.load(args.id_or_name)
    actor = current_human_actor()
    reason = args.reason or "stopped"
    if getattr(args, "lane", None):
        _stop_one(resolve_lane(ctx.store, session, args.lane)["id"], ctx.store, ctx.herdr, actor, reason)
        return EXIT_OK
    if not (args.keep_children or getattr(args, "keep_lanes", False)):
        for child_id in list(session["lineage"]["children"]):
            _stop_one(child_id, ctx.store, ctx.herdr, actor, "parent_stopped")
    _stop_one(session["id"], ctx.store, ctx.herdr, actor, reason)
    return EXIT_OK


def cmd_rename(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if ctx.store.name_taken(args.new_name, exclude_id=session["id"]):
        raise ConflictError(f"session name '{args.new_name}' is already in use by a live session")
    actor = current_human_actor()
    old_name = session["name"]
    ev = ctx.store.append_event(session["id"], "session.renamed", actor, {"from": old_name, "to": args.new_name})
    session["name"] = args.new_name
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    if session.get("runtime") is not None:
        new_alias = derive_herdr_alias(args.new_name, session["id"])
        ctx.herdr.agent_rename(agent_id=session["runtime"].get("agent_id"), new_alias=new_alias)
    return EXIT_OK


def cmd_assign(args, ctx):
    session = ctx.store.load(args.id_or_name)
    new_owner = parse_actor_string(args.owner_actor)
    actor = current_human_actor()
    old_owner = session["owner"]["actor"]
    ev = ctx.store.append_event(session["id"], "owner.assigned", actor, {"from": old_owner, "to": new_owner})
    session["owner"] = {"actor": new_owner, "assigned_at": ev["ts"], "assigned_by": actor}
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    return EXIT_OK


def cmd_goal(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if args.action == "show":
        goal = session.get("goal")
        print(goal["text"] if goal else "")
        return EXIT_OK
    if args.action == "set" and not args.text:
        raise UsageError("goal set requires <text>")
    text = args.text if args.action == "set" else ""
    actor = current_human_actor()
    ev = ctx.store.append_event(session["id"], "goal.set", actor, {"text": text})
    session["goal"] = {"text": text, "set_by": actor, "set_at": ev["ts"]} if text else None
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    return EXIT_OK


def cmd_log(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if args.transcript is not None:
        try:
            result = ctx.herdr.call("agent.read", {
                "target": (session.get("runtime") or {}).get("agent_id"),
                "source": "recent_unwrapped", "lines": args.transcript,
            })
        except (HerdrUnavailable, HerdrError) as e:
            # log's own Exit table is 0,3 only (no 4): degrade gracefully.
            print(f"# transcript unavailable: {e}")
            return EXIT_OK
        print(result)
        return EXIT_OK

    events = ctx.store.read_events(session["id"], since=args.since, type_filter=args.type_filter)
    if args.json:
        for e in events:
            print(json.dumps(e))
    else:
        for e in events:
            print(f"{e['seq']:>6}  {e['ts']}  {e['type']:<22} {actor_to_string(e['actor'])}  {json.dumps(e['data'])}")

    if args.follow:
        last_seq = events[-1]["seq"] if events else (args.since or 0)
        try:
            while True:
                time.sleep(0.5)
                new_events = ctx.store.read_events(session["id"], since=last_seq, type_filter=args.type_filter)
                for e in new_events:
                    if args.json:
                        print(json.dumps(e))
                    else:
                        print(f"{e['seq']:>6}  {e['ts']}  {e['type']:<22} {actor_to_string(e['actor'])}  {json.dumps(e['data'])}")
                    last_seq = e["seq"]
        except KeyboardInterrupt:
            pass
    return EXIT_OK


def cmd_receipt(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if args.write:
        end_state = session["status"]["state"] if session["status"]["state"] in TERMINAL_STATES else None
        end_reason = session["status"].get("detail") if end_state else None
        ended_at = session["status"]["since"] if end_state else None
        receipt = compute_receipt(ctx.store, session, end_state, end_reason, ended_at)
        write_receipt(ctx.store, receipt)
        ev = ctx.store.append_event(session["id"], "receipt.written", current_human_actor(),
                                     {"receipt_summary": {"end_state": end_state, "state_version": receipt["state_version"]}})
        session["state_version"] = ev["seq"]
        ctx.store.save_session(session)
    else:
        existing = ctx.store.receipt_path(session["id"])
        if existing.exists():
            receipt = json.loads(existing.read_text(encoding="utf-8"))
        else:
            receipt = compute_receipt(ctx.store, session)  # display-only, not persisted

    if args.json:
        print(json.dumps(receipt, indent=2))
    elif getattr(args, "pager", False):
        page_text(render_receipt_text(receipt))
    else:
        print(render_receipt_text(receipt))
    return EXIT_OK


def page_text(text):
    """Pipe `text` through `less -R` (the panel's Receipt action runs
    inside a TUI window, 03-sessions-panel.md); print it plainly when
    less is not installed."""
    try:
        subprocess.run(["less", "-R"], input=text + "\n", text=True)
    except FileNotFoundError:
        print(text)


def cmd_capture(args, ctx):
    session = ctx.store.load(args.id_or_name)
    actor = current_human_actor()
    if args.screenshot:
        path, source_hint = do_screenshot_capture(session)
        entry, _dest = add_artifact(ctx.store, session["id"], "capture", str(path), args.label, actor)
    elif getattr(args, "preview", False):
        path, source_hint = capture_preview_to_file(session)
        label = args.label or f"preview-{loop_counts(session)['captures'] + 1}"
        entry, _dest = add_artifact(ctx.store, session["id"], "capture", str(path), label, actor)
    elif args.file:
        entry, _dest = add_artifact(ctx.store, session["id"], "file", args.file, args.label, actor)
    else:
        entry, _dest = add_artifact(ctx.store, session["id"], "url", args.url, args.label, actor)
    ev = ctx.store.append_event(session["id"], "artifact.added", actor,
                                 {"path": entry["path"], "label": entry["label"], "added_by": actor})
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    print(entry["path"])
    return EXIT_OK


def cmd_artifact_add(args, ctx):
    session = ctx.store.load(args.id_or_name)
    actor = current_human_actor()
    entry, _dest = add_artifact(ctx.store, session["id"], args.kind, args.source, args.label, actor)
    data = {"path": entry["path"], "label": entry["label"], "added_by": actor, "kind": args.kind}
    if args.kind == "url":
        data["url"] = args.source   # 09-closed-loop-surfaces.md section 6: a design frame as a link
    ev = ctx.store.append_event(session["id"], "artifact.added", actor, data)
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    print(entry["path"])
    return EXIT_OK


def cmd_artifact_mark(args, ctx):
    session = ctx.store.load(args.id_or_name)
    actor = current_human_actor()
    data = mark_artifact(ctx.store, session["id"], args.artifact, args.state)
    ev = ctx.store.append_event(session["id"], "artifact.updated", actor,
                                 {"label": data.get("label"), "path": data.get("path"), "state": args.state})
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    print(f"{data.get('label')}: {args.state}")
    return EXIT_OK


_URL_SCHEME_RE = re.compile(r"^[a-zA-Z][a-zA-Z0-9+.-]*://")


def hypr_clients():
    """Hyprland's window list, or [] when hyprctl is unavailable (tests,
    ssh without the session environment)."""
    try:
        r = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            return []
        data = json.loads(r.stdout or "[]")
        return data if isinstance(data, list) else []
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError, OSError):
        return []


def preview_window_class(preview):
    """The window class a registered preview shows up as. An app_id preview
    is its own class. A url preview opened through omarchy-launch-webapp is
    a Chromium --app window, whose class is "chrome-" + host + "__" + the
    path without its leading slash, "/" turned into "_", + "-Default"
    (observed on the rig, 2026-09-02: file:///home/omarchy/x/hello.html
    became chrome-__home_omarchy_x_hello.html-Default; Omarchy's own web
    apps read chrome-chatgpt.com__-Default)."""
    if not preview:
        return None
    if preview.get("kind") == "app_id":
        return preview.get("value")
    value = preview.get("value") or ""
    parsed = urllib.parse.urlsplit(value)
    path = parsed.path[1:] if parsed.path.startswith("/") else parsed.path
    return "chrome-" + parsed.netloc + "__" + path.replace("/", "_") + "-Default"


def find_preview_window(preview):
    cls = preview_window_class(preview)
    if not cls:
        return None
    for c in hypr_clients():
        if c.get("class") == cls or (c.get("class") or "").startswith(cls.rsplit("-Default", 1)[0]):
            return c
    return None


def focus_preview(session, launch=True):
    """Focus the registered preview window; launch it first when it is a url
    with no window yet (09-closed-loop-surfaces.md section 2). Returns
    "focused", "launched", or None when there is nothing to do."""
    preview = session.get("preview")
    if not preview:
        return None
    win = find_preview_window(preview)
    if win is not None:
        with contextlib.suppress(FileNotFoundError, subprocess.TimeoutExpired, OSError):
            subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{win["address"]}" }})'],
                           capture_output=True, text=True, timeout=5)
        return "focused"
    if launch and preview.get("kind") == "url":
        with contextlib.suppress(FileNotFoundError, OSError):
            subprocess.Popen(["omarchy-launch-webapp", preview["value"]],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        return "launched"
    return None


def capture_preview_to_file(session):
    """A capture nobody has to click for: the registered preview window's
    geometry when it is on screen, else the whole screen. Returns
    (path, source_hint). `omarchy capture screenshot` wants a person to
    pick a region, which makes it unusable from a script or the panel
    (run 3, 2026-09-02)."""
    scratch = pathlib.Path(tempfile.mkdtemp(prefix="omarchy-capture-"))
    path = scratch / f"capture-{now_rfc3339().replace(':', '-')}.png"
    win = find_preview_window(session.get("preview"))
    argv = ["grim"]
    hint = "monitor"
    if win is not None:
        at, size = win.get("at") or [0, 0], win.get("size") or [0, 0]
        if size and size[0] > 0 and size[1] > 0:
            argv += ["-g", f"{int(at[0])},{int(at[1])} {int(size[0])}x{int(size[1])}"]
            hint = "preview"
    argv.append(str(path))
    try:
        subprocess.run(argv, check=True, capture_output=True, text=True, timeout=15)
    except (FileNotFoundError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
        raise CaptureError(f"grim could not capture the screen: {e}") from e
    if not path.exists():
        raise CaptureError("grim produced no file")
    return path, hint


def cmd_preview(args, ctx):
    session = ctx.store.load(args.id_or_name)
    if args.value:
        kind = "url" if _URL_SCHEME_RE.match(args.value) else "app_id"
        actor = current_human_actor()
        ev = ctx.store.append_event(session["id"], "preview.set", actor, {"kind": kind, "value": args.value})
        session["preview"] = {"kind": kind, "value": args.value}
        session["state_version"] = ev["seq"]
        ctx.store.save_session(session)
    if args.focus:
        if not session.get("preview"):
            raise ConflictError(f"session '{session['name']}' has no registered preview")
        result = focus_preview(session)
        print(result or "no preview window")
    elif not args.value:
        raise UsageError("preview needs a value to register, or --focus")
    return EXIT_OK


def cmd_mode(args, ctx):
    session = ctx.store.load(args.id_or_name)
    validate_mode_supported(session["agent"]["kind"], args.new_mode)
    actor = current_human_actor()
    runtime = session.get("runtime")

    if runtime is not None and session["status"]["state"] != "orphaned":
        ref = session["agent"].get("harness_session_ref")
        argv, env, _cell = assemble_launch(session["agent"]["kind"], args.new_mode)
        if ref:
            argv = list(RESUME_FLAGS.get(session["agent"]["kind"], ["--resume"])) + [ref] + argv
        alias = derive_herdr_alias(session["name"], session["id"])
        with contextlib.suppress(HerdrError):
            ctx.herdr.call("agent.send_keys", {"target": alias, "keys": ["ctrl+c"]})
        ctx.herdr.pane_close(pane_id=runtime.get("pane_id"))  # HerdrUnavailable propagates -> exit 4
        result = ctx.herdr.agent_start(alias=alias, kind=session["agent"]["kind"],
                                        cwd=(session.get("workspace") or {}).get("worktree_path"),
                                        flags=argv, env=env, focus=False)
        result = result or {}
        new_runtime = {"backend": "herdr", "session": result.get("session"),
                       "workspace_id": result.get("workspace_id"), "tab_id": result.get("tab_id"),
                       "pane_id": result.get("pane_id"), "agent_id": result.get("agent_id")}
        ev = ctx.store.append_event(session["id"], "runtime.bound", actor, new_runtime)
        session["runtime"] = new_runtime
        session["state_version"] = ev["seq"]

    old_mode = session["mode"]
    ev = ctx.store.append_event(session["id"], "mode.changed", actor, {"from": old_mode, "to": args.new_mode, "changed_by": actor})
    session["mode"] = args.new_mode
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    return EXIT_OK


def cmd_done(args, ctx):
    session = ctx.store.load(args.id_or_name)
    actor = current_human_actor()
    if getattr(args, "lane", None):
        session = resolve_lane(ctx.store, session, args.lane)
    if session["status"]["state"] in TERMINAL_STATES:
        raise ConflictError(f"session '{session['name']}' already ended ({session['status']['state']})")
    merge = None
    if is_lane(session) and args.verdict == "kept":
        parent = ctx.store.load(session["lane"]["parent_id"])
        merge = merge_lane_into_session(ctx.store, parent, session, actor)
        if not merge["merged"] and merge["reason"] == "merge conflict":
            detail = "merge conflict; open the lane to resolve"
            old = session["status"]["state"]
            ev = ctx.store.append_event(session["id"], "status.changed", actor,
                                         {"from": old, "to": "blocked", "source": "omarchy", "detail": detail})
            session["status"] = {"state": "blocked", "since": ev["ts"], "source": "omarchy", "detail": detail}
            session["state_version"] = ev["seq"]
            ctx.store.save_session(session)
            raise ConflictError(f"lane '{session['lane']['name']}' did not merge: {merge.get('output') or 'conflict'}")
    note = args.note
    if merge is not None and merge["merged"]:
        note = f"{note}\n\nMerged {len(merge['commits'])} commit(s) ({merge['range']}) into the session branch." if note else f"Merged {len(merge['commits'])} commit(s) ({merge['range']}) into the session branch."
    entry, _dest = add_artifact(ctx.store, session["id"], "note", note, "verdict", actor)
    ev = ctx.store.append_event(session["id"], "artifact.added", actor,
                                 {"path": entry["path"], "label": "verdict", "added_by": actor})
    session["state_version"] = ev["seq"]

    # The verdict closes the loop, so the harness goes with it: `done` used
    # to leave the pane running and bound, and a done session's harness
    # then ran on until someone found it (run 3, 2026-09-02).
    old_state = session["status"]["state"]
    runtime = session.get("runtime")
    ev = ctx.store.append_event(session["id"], "status.changed", actor,
                                 {"from": old_state, "to": "done", "source": "human", "detail": args.verdict})
    session["status"] = {"state": "done", "since": ev["ts"], "source": "human", "detail": args.verdict}
    session["state_version"] = ev["seq"]
    if runtime is not None:
        ev = ctx.store.append_event(session["id"], "runtime.unbound", actor, {"reason": "done"})
        session["runtime"] = None
        session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    if runtime is not None:
        # Record first, pane second, as in `_stop_one`.
        session["runtime"] = runtime
        session["status"]["state"] = old_state
        try:
            _release_runtime(session, ctx.herdr, "done")
        finally:
            session["runtime"] = None
            session["status"]["state"] = "done"
    cleanup_workspace_if_owned(session, ctx.herdr)

    ev = ctx.store.append_event(session["id"], "session.ended", actor, {"state": "done", "reason": f"verdict:{args.verdict}"})
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)

    receipt = compute_receipt(ctx.store, session, "done", f"verdict:{args.verdict}", ev["ts"])
    write_receipt(ctx.store, receipt)
    ev = ctx.store.append_event(session["id"], "receipt.written", actor,
                                 {"receipt_summary": {"end_state": "done", "state_version": receipt["state_version"]}})
    session["state_version"] = ev["seq"]
    ctx.store.save_session(session)
    notify_parent_of_completion(ctx.store, ctx.herdr, session, "done", f"verdict:{args.verdict}")
    return EXIT_OK


HERDR_STATUS_MAP = {"blocked": "blocked", "working": "working", "idle": "idle", "done": "idle"}


def claude_project_dir(cwd):
    """Claude Code keeps one transcript per conversation under
    ~/.claude/projects/<cwd with every "/" and "." turned into "-">/<sessionId>.jsonl
    (observed on the rig 2026-09-02: /home/omarchy/.herdr/worktrees/x became
    -home-omarchy--herdr-worktrees-x)."""
    slug = re.sub(r"[/.]", "-", str(pathlib.Path(cwd).resolve()))
    return pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR", str(pathlib.Path.home() / ".claude"))) / "projects" / slug


def transcript_started_at(path):
    """Epoch of the first timestamped line of a Claude Code transcript, or
    the file's mtime when no line carries one."""
    try:
        with open(path, encoding="utf-8") as fh:
            for _ in range(20):
                line = fh.readline()
                if not line:
                    break
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                ts = d.get("timestamp") if isinstance(d, dict) else None
                if isinstance(ts, str):
                    try:
                        return dt.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
                    except ValueError:
                        pass
        return os.path.getmtime(path)
    except OSError:
        return None


def discover_harness_session_ref(kind, cwd, since_epoch, taken=()):
    """Find the harness's own resume id for a session started at or after
    since_epoch in cwd. Only Claude Code is wired in slice 1: of the
    transcript files in its project directory that *started* at or after
    the session did, the earliest-starting one not already held by another
    session. Run 2 (2026-09-02): two sessions created five seconds apart in
    the same directory both took the newest file by mtime, so one would
    have revived the other's conversation. Returns None when nothing
    qualifies yet (Claude writes the file on the first turn, not at
    launch)."""
    if kind != "claude" or not cwd:
        return None
    d = claude_project_dir(cwd)
    taken = set(taken or ())
    try:
        files = [f for f in d.glob("*.jsonl") if f.stem not in taken and f.stat().st_mtime >= since_epoch - 2]
    except OSError:
        return None
    candidates = []
    for f in files:
        started = transcript_started_at(f)
        if started is not None and started >= since_epoch - 2:
            candidates.append((started, f.stem))
    if not candidates:
        return None
    candidates.sort()
    return candidates[0][1]


def record_harness_session_ref(store, session, herdr=None):
    """Fill agent.harness_session_ref when it is missing and discoverable,
    and tell Herdr through pane.report_agent_session so its sidebar and a
    later attach agree with the record. Returns True when something was
    recorded."""
    if session["agent"].get("harness_session_ref"):
        return False
    runtime = session.get("runtime")
    if runtime is None:
        return False
    cwd = (session.get("workspace") or {}).get("worktree_path")
    try:
        since = dt.datetime.fromisoformat(session["created_at"].replace("Z", "+00:00")).timestamp()
    except (KeyError, ValueError):
        since = 0
    taken = {s["agent"].get("harness_session_ref") for s in store.list_sessions()
             if s["id"] != session["id"] and s["agent"].get("harness_session_ref")}
    ref = discover_harness_session_ref(session["agent"]["kind"], cwd, since, taken=taken)
    if not ref:
        return False
    session["agent"]["harness_session_ref"] = ref
    store.save_session(session)
    if herdr is not None and runtime.get("pane_id"):
        with contextlib.suppress(HerdrError, HerdrUnavailable):
            herdr.call("pane.report_agent_session", {
                "pane_id": runtime["pane_id"], "source": "omarchy-agent-session",
                "agent": session["agent"]["kind"], "agent_session_id": ref,
                "agent_session_path": str(claude_project_dir(cwd) / f"{ref}.jsonl") if cwd else None,
            })
    return True


def apply_herdr_status(store, session, herdr_status, source="herdr-manifest", detail=None):
    """Map a Herdr agent_status onto the session state machine
    (01-session-model.md): done with a live pane means idle; unknown keeps
    the previous state and records the detail. Appends status.changed only
    when the state actually changes. Returns the (possibly updated) session."""
    state = session["status"]["state"]
    if state in TERMINAL_STATES or session.get("runtime") is None:
        return session
    if herdr_status == "unknown" or herdr_status is None:
        if session["status"].get("detail") != "unknown":
            session["status"]["detail"] = "unknown"
            store.save_session(session)
        return session
    new_state = HERDR_STATUS_MAP.get(herdr_status)
    if not new_state or new_state == state:
        return session
    ev = store.append_event(session["id"], "status.changed", agent_actor(session["id"], "herdr"),
                            {"from": state, "to": new_state, "source": source, "detail": detail})
    session["status"] = {"state": new_state, "since": ev["ts"], "source": source, "detail": detail}
    session["state_version"] = ev["seq"]
    store.save_session(session)
    return session


def build_sessions_index(store, herdr_state, orphaned, adopted):
    """The reconciler's index (03-sessions-panel.md): `generated_at` is the
    panel's liveness signal, the rest summarizes this run and the store
    after it. `live` counts sessions in neither a terminal state nor
    `orphaned`; `needs_attention` counts waiting/blocked."""
    states = [(s.get("status") or {}).get("state") for s in store.list_sessions()]
    return {
        "generated_at": now_rfc3339(),
        "herdr": herdr_state,
        "orphaned": list(orphaned),
        "adopted": list(adopted),
        "counts": {
            "needs_attention": sum(1 for st in states if st in NEEDS_ATTENTION_STATES),
            "live": sum(1 for st in states if st not in TERMINAL_STATES and st != "orphaned"),
            "orphaned": sum(1 for st in states if st == "orphaned"),
        },
    }


def write_sessions_index(store, herdr_state, orphaned, adopted):
    """Atomically rewrite <sessions root>/index.json. Best-effort by
    contract: the panel only loses a liveness tick if this fails, so a
    failure is reported on stderr and never changes reconcile's exit code
    or stdout."""
    try:
        atomic_write_json(store.index_path(), build_sessions_index(store, herdr_state, orphaned, adopted))
    except Exception as e:  # noqa: BLE001 -- anything here is non-fatal by design
        eprint(f"reconcile: could not write {store.index_path()}: {e}")


def herdr_server_started_at():
    """When the running Herdr server came up, from its socket's mtime (a
    Unix socket is created at server start and never written as a file).
    None when the socket is missing."""
    try:
        return os.stat(herdr_socket_path()).st_mtime
    except OSError:
        return None


def runtime_bound_at(store, session):
    """Epoch of the session's latest runtime.bound event, or None."""
    latest = None
    for e in store.read_events(session["id"]):
        if e.get("type") == "runtime.bound":
            latest = e.get("ts")
    if not latest:
        return None
    try:
        return parse_rfc3339(latest).timestamp()
    except ValueError:
        return None


RESTART_MARGIN_S = 2.0


def herdr_restarted_since_binding(store, session):
    """True when the Herdr server started after this session's harness was
    bound to it. A server restart (a reboot, above all) restores every
    workspace with a fresh shell and no agent, which looks exactly like a
    harness that exited on its own; the difference is that the person can
    revive this one (rig, 2026-09-02 22:30: two working sessions were marked
    failed one second after the post-reboot Herdr came up)."""
    started = herdr_server_started_at()
    bound = runtime_bound_at(store, session)
    if started is None or bound is None:
        return False
    return started >= bound + RESTART_MARGIN_S


def sweep_ended_workspaces(ctx, known, live_agents, live_panes):
    """Close the empty shell panes Herdr keeps for sessions that have
    ended or been orphaned. Herdr restores every workspace, with a fresh
    shell, when its server restarts, and `stop` on an orphaned session has
    no pane to close, so by the end of run 2 (2026-09-02) eight dead
    workspaces sat in Herdr's list. Precise on purpose: only a workspace
    this launcher bound to the session (the last `runtime.bound` event
    names it), never one that came from an adopted agent, and only while
    no live agent runs in it. Returns the session ids whose panes were
    closed."""
    agent_workspaces = {a.get("workspace_id") for a in live_agents if a.get("workspace_id")}
    panes_by_workspace = {}
    for p in live_panes:
        wid = p.get("workspace_id")
        if wid and p.get("pane_id"):
            panes_by_workspace.setdefault(wid, []).append(p["pane_id"])
    swept = []
    for s in known:
        state = s["status"]["state"]
        if state not in TERMINAL_STATES and state != "orphaned":
            continue
        if s.get("runtime") is not None:
            continue
        events = ctx.store.read_events(s["id"])
        if any(e["type"] == "session.created" and (e.get("data") or {}).get("adopted") for e in events):
            continue
        # Every workspace this launcher ever bound to the session: a
        # revived session binds a new one, and Herdr restores the old one
        # too after a server restart.
        wids = {(e.get("data") or {}).get("workspace_id") for e in events if e["type"] == "runtime.bound"}
        closed = False
        for wid in wids:
            if not wid or wid in agent_workspaces or wid not in panes_by_workspace:
                continue
            for pane_id in panes_by_workspace[wid]:
                try:
                    ctx.herdr.pane_close(pane_id=pane_id)
                    closed = True
                except (HerdrError, HerdrUnavailable):
                    pass
        if closed:
            swept.append(s["id"])
    return swept


def cmd_reconcile(args, ctx):
    actor = system_actor()
    known = ctx.store.list_sessions()
    try:
        live_panes = ctx.herdr.pane_list() or []
        live_agents = ctx.herdr.agent_list() or []
    except HerdrUnavailable:
        # No server at all (typically right after a reboot): every bound,
        # live session lost its pane. Orphan them so the panel stops
        # showing a runtime that is gone and `open` can revive them, then
        # report the outage with exit 4 as the command contract says.
        orphaned = []
        for s in known:
            if s.get("runtime") is None or s["status"]["state"] in TERMINAL_STATES:
                continue
            ev = ctx.store.append_event(s["id"], "status.changed", actor,
                                         {"from": s["status"]["state"], "to": "orphaned",
                                          "source": "reconciler", "detail": "Herdr server not running"})
            s["status"] = {"state": "orphaned", "since": ev["ts"], "source": "reconciler", "detail": "Herdr server not running"}
            s["state_version"] = ev["seq"]
            ev = ctx.store.append_event(s["id"], "runtime.unbound", actor, {"reason": "herdr_unavailable"})
            s["runtime"] = None
            s["state_version"] = ev["seq"]
            ctx.store.save_session(s)
            orphaned.append(s["id"])
        write_sessions_index(ctx.store, "unreachable", orphaned, [])
        if args.json:
            print(json.dumps({"orphaned": orphaned, "adopted": [], "herdr": "unreachable"}, indent=2))
        else:
            print(f"orphaned {len(orphaned)}, adopted 0 (Herdr unreachable)")
        raise
    live_agent_ids = {a.get("agent_id") for a in live_agents if a.get("agent_id")}
    live_pane_ids = {p.get("pane_id") for p in live_panes if p.get("pane_id")}

    orphaned, adopted, ended = [], [], []
    for s in known:
        runtime = s.get("runtime")
        if runtime is None or s["status"]["state"] in TERMINAL_STATES:
            continue
        agent_id, pane_id = runtime.get("agent_id"), runtime.get("pane_id")
        agent_alive = bool(agent_id) and agent_id in live_agent_ids
        pane_alive = bool(pane_id) and pane_id in live_pane_ids
        still_present = agent_alive or pane_alive
        if agent_alive:
            live = next((a for a in live_agents if a.get("agent_id") == agent_id), None)
            if live is not None:
                apply_herdr_status(ctx.store, s, live.get("agent_status"))
                record_harness_session_ref(ctx.store, s, ctx.herdr)
                # pattern 06: pending watch notices reach a live watcher on
                # the next tick, between its turns.
                if any(q.get("delivery") == "watch" for q in s.get("queue") or []) and (live.get("agent_status") in ("idle", "done")):
                    with contextlib.suppress(Exception):
                        deliver_pending(ctx.store.load(s["id"]), ctx, only_delivery="watch")
        elif pane_alive and s["status"]["state"] != "starting" and herdr_restarted_since_binding(ctx.store, s):
            # The pane is the fresh shell Herdr opens for every restored
            # workspace when its server restarts; the harness did not exit,
            # the machine (or the server) did. The session is revivable, so
            # it is orphaned, never ended (rig, 2026-09-02 22:30: a reboot
            # marked two working sessions failed and Enter opened receipts
            # instead of reviving them).
            with contextlib.suppress(HerdrError, HerdrUnavailable):
                ctx.herdr.pane_close(pane_id=pane_id)
            detail = "Herdr restarted; Enter revives"
            ev = ctx.store.append_event(s["id"], "status.changed", actor,
                                         {"from": s["status"]["state"], "to": "orphaned",
                                          "source": "reconciler", "detail": detail})
            s["status"] = {"state": "orphaned", "since": ev["ts"], "source": "reconciler", "detail": detail}
            s["state_version"] = ev["seq"]
            ev = ctx.store.append_event(s["id"], "runtime.unbound", actor, {"reason": "herdr_restarted"})
            s["runtime"] = None
            s["state_version"] = ev["seq"]
            ctx.store.save_session(s)
            orphaned.append(s["id"])
            continue
        elif pane_alive and s["status"]["state"] != "starting":
            # The harness exited and left its shell pane behind (the person
            # typed /exit, or the process died). Herdr drops the agent from
            # its list while the pane lives on, so this used to read as
            # `idle` forever (rig, 2026-09-02). 01-session-model.md: any
            # live state -> done when the harness exits cleanly, failed when
            # it exits with an error. Herdr exposes no exit status, so the
            # state at the moment it vanished decides: gone while `working`
            # is a failure (nothing finishes a turn by exiting), gone while
            # idle, waiting, or blocked is an exit. `starting` is excluded
            # because a harness that is still booting is not in Herdr's
            # agent list yet either.
            # The pane existed for the session; with the harness gone it is
            # an empty shell that would sit in Herdr's list forever (run 2,
            # 2026-09-02: `stop` on an ended session leaves panes alone).
            # Pane and worktree first, as `stop` does, so the receipt
            # carries the worktree decision.
            with contextlib.suppress(HerdrError, HerdrUnavailable):
                ctx.herdr.pane_close(pane_id=pane_id)
            cleanup_workspace_if_owned(s, ctx.herdr)
            if s["status"]["state"] == "working":
                _end_session(s, ctx.store, actor, "failed", "harness exited while working", unbind_reason="harness_exited")
            else:
                _end_session(s, ctx.store, actor, "done", "harness exited", unbind_reason="harness_exited")
            ended.append(s["id"])
            continue
        if not still_present:
            ev = ctx.store.append_event(s["id"], "status.changed", actor,
                                         {"from": s["status"]["state"], "to": "orphaned",
                                          "source": "reconciler", "detail": "pane not found in Herdr's list"})
            s["status"] = {"state": "orphaned", "since": ev["ts"], "source": "reconciler", "detail": "pane not found in Herdr's list"}
            s["state_version"] = ev["seq"]
            ev = ctx.store.append_event(s["id"], "runtime.unbound", actor, {"reason": "pane_gone"})
            s["runtime"] = None
            s["state_version"] = ev["seq"]
            ctx.store.save_session(s)
            orphaned.append(s["id"])

    swept = sweep_ended_workspaces(ctx, known, live_agents, live_panes)

    known_agent_ids = {(s.get("runtime") or {}).get("agent_id") for s in known if s.get("runtime")}
    for a in live_agents:
        agent_id = a.get("agent_id")
        if not agent_id or agent_id in known_agent_ids:
            continue
        session_id = new_ulid()
        name = f"herdr-{a.get('name') or agent_id}"
        runtime = {"backend": "herdr", "session": a.get("session"), "workspace_id": a.get("workspace_id"),
                   "tab_id": a.get("tab_id"), "pane_id": a.get("pane_id"), "agent_id": agent_id}
        workspace = {"repo_root": None, "worktree_path": None, "branch": None, "base_branch": None, "created_by_session": False}
        # Mode is unknown for an externally-started agent; "shared" is this
        # build's conservative default since Personal's trust model (a
        # human already watching) can't be asserted for a pane omarchy
        # didn't launch -- see README-core.md.
        record = new_session_record(session_id, name, actor, actor, "shared", a.get("kind", "unknown"),
                                     workspace, cwd=None, command=None)
        ctx.store.append_event(session_id, "session.created", actor, {"name": name, "adopted": True})
        record["state_version"] = 1
        ctx.store.save_session(record)
        ev = ctx.store.append_event(session_id, "runtime.bound", actor, runtime)
        record["runtime"] = runtime
        record["state_version"] = ev["seq"]
        ev = ctx.store.append_event(session_id, "status.changed", actor,
                                     {"from": "starting", "to": "working", "source": "herdr-manifest", "detail": "adopted by reconcile"})
        record["status"] = {"state": "working", "since": ev["ts"], "source": "herdr-manifest", "detail": "adopted by reconcile"}
        record["state_version"] = ev["seq"]
        ctx.store.save_session(record)
        adopted.append(session_id)

    write_sessions_index(ctx.store, "running", orphaned, adopted)
    if args.json:
        print(json.dumps({"orphaned": orphaned, "adopted": adopted, "ended": ended, "swept": swept}, indent=2))
    else:
        print(f"orphaned {len(orphaned)}, adopted {len(adopted)}, ended {len(ended)}, swept {len(swept)}")
    return EXIT_OK


COMMAND_HANDLERS = {
    "new": cmd_new, "list": cmd_list, "show": cmd_show, "open": cmd_open,
    "send": cmd_send, "stop": cmd_stop, "rename": cmd_rename, "assign": cmd_assign,
    "goal": cmd_goal, "log": cmd_log, "receipt": cmd_receipt, "capture": cmd_capture,
    "artifact-add": cmd_artifact_add, "preview": cmd_preview, "mode": cmd_mode,
    "done": cmd_done, "reconcile": cmd_reconcile,
    "add": cmd_add, "lanes": cmd_lanes, "subscribe": cmd_subscribe, "artifact-mark": cmd_artifact_mark,
}


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    main_args, extra_args = split_double_dash(argv)
    parser = build_parser()
    try:
        args = parser.parse_args(main_args)
    except SystemExit as e:
        return e.code if isinstance(e.code, int) else EXIT_USAGE
    args.extra_args = extra_args
    # The literal invocation this process was asked to run, reconstructed
    # from the argv actually passed to main() -- not from sys.argv, which
    # would be wrong whenever main() is called in-process (tests) and
    # wouldn't reliably round-trip a `-- <agent args>` tail either way.
    # Used for the receipt's started_with.command (05-receipts-and-artifacts.md).
    raw_parts = list(main_args) + (["--"] + list(extra_args) if extra_args else [])
    args.raw_command = shlex.join(raw_parts)

    store = SessionStore(sessions_root())
    herdr = HerdrClient(herdr_socket_path())
    ctx = Context(store, herdr)
    handler = COMMAND_HANDLERS[args.command]

    try:
        return handler(args, ctx)
    except UsageError as e:
        eprint(str(e))
        return e.exit_code
    except NotFoundError as e:
        eprint(str(e))
        return e.exit_code
    except ConflictError as e:
        eprint(str(e))
        return e.exit_code
    except HerdrUnavailable as e:
        eprint(f"Herdr unreachable: {e}")
        return EXIT_HERDR_UNREACHABLE
    except HerdrError as e:
        eprint(f"Herdr error: {e}")
        return EXIT_HERDR_UNREACHABLE
    except SessionError as e:
        eprint(str(e))
        return getattr(e, "exit_code", 1)
    except GitError as e:
        eprint(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main())
