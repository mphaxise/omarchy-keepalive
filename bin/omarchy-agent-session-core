    p = sub.add_parser("capture")
    add_id_arg(p)
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--screenshot", action="store_true")
    g.add_argument("--preview", action="store_true", help="grab the registered preview window without asking (fullscreen when none)")
    g.add_argument("--file")
    g.add_argument("--url")
    p.add_argument("--label")

    p = sub.add_parser("artifact-add")
