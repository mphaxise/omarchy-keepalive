    p.add_argument("--kind", required=True, choices=["capture", "file", "url", "note"])
    p.add_argument("--source", required=True)
    p.add_argument("--label")

    p = sub.add_parser("preview")
    add_id_arg(p)
    p.add_argument("value", nargs="?")
    p.add_argument("--focus", action="store_true", help="focus (or launch) the registered preview window")

    p = sub.add_parser("mode")
    add_id_arg(p)
    p.add_argument("new_mode", choices=["personal", "shared", "restricted"])

    p = sub.add_parser("done")
    add_id_arg(p)
    p.add_argument("--verdict", required=True, choices=["kept", "reverted", "needs-person"])
    p.add_argument("--note", required=True)
    p.add_argument("--lane", help="end one lane: kept merges its branch into the session's, the others leave it")

    p = sub.add_parser("reconcile")
    p.add_argument("--json", action="store_true")

    return parser


# --------------------------------------------------------------------------
# Command handlers
