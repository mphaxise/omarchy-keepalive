class Context:
    def __init__(self, store, herdr):
        self.store = store
        self.herdr = herdr


def split_double_dash(argv):
    if "--" in argv:
        idx = argv.index("--")
        return argv[:idx], argv[idx + 1:]
    return argv, []


def add_id_arg(p):
    p.add_argument("id_or_name")


