    p.add_argument("--timeout", type=int)

    p = sub.add_parser("stop")
    add_id_arg(p)
    p.add_argument("--keep-children", action="store_true")
    p.add_argument("--keep-lanes", action="store_true", help="stop the session's own agent and leave its lanes running")
    p.add_argument("--lane", help="stop one lane only")
    p.add_argument("--reason")

    p = sub.add_parser("rename")
    add_id_arg(p)
    p.add_argument("new_name")

    p = sub.add_parser("assign")
    add_id_arg(p)
    p.add_argument("owner_actor")

    p = sub.add_parser("goal")
    add_id_arg(p)
    p.add_argument("action", choices=["set", "clear", "show"])
