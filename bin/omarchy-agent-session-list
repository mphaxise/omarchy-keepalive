#!/bin/bash

# omarchy:summary=List agent sessions from local session records
# omarchy:args=[--state <state>] [--mine] [--json]
# omarchy:examples=omarchy agent session list --state waiting --json

set -euo pipefail

# Reads local session.json files only; no Herdr call, so the panel never polls
# Herdr to render (spec/02-command-surface.md).
exec omarchy-agent-session-core list "$@"
